@model HastaneRandevuSistemi.ViewModels.SymptomResultViewModel

@{
    ViewData["Title"] = "Semptom Analiz Sonucu";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-2"></i>Semptomları Düzenle
        </a>
    </div>

    <div class="alert alert-info rounded-4 border-0 shadow-sm">
        <i class="fa-solid fa-circle-info me-2"></i>@Model.WarningMessage
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="text-muted small mb-2">Seçilen semptomlar</div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var label in Model.SelectedSymptomLabels)
                {
                    <span class="badge rounded-pill bg-light text-dark border px-3 py-2">@label</span>
                }
            </div>
        </div>
    </div>

    <div class="row g-3">
        @if (!Model.Suggestions.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h2 class="h5 fw-bold">Dahiliye (İç Hastalıkları)</h2>
                        <p class="text-muted mb-3">Genel değerlendirme için uygun bir başlangıç bölümüdür.</p>
                        <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary rounded-pill px-4">Randevu Al</a>
                    </div>
                </div>
            </div>
        }
        @foreach (var item in Model.Suggestions)
        {
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between gap-3">
                            <h2 class="h5 fw-bold mb-2">
                                <i class="fa-solid @item.Icon text-primary me-2"></i>@item.DepartmentName
                            </h2>
                            <span class="badge bg-@item.BadgeColor rounded-pill align-self-start">@item.ConfidenceScore%</span>
                        </div>
                        <p class="text-muted">@item.Reasoning</p>
                        <a asp-controller="Appointment" asp-action="Create" asp-route-departmentId="@item.DepartmentId" class="btn btn-outline-primary rounded-pill px-4">
                            Bu Bölümden Randevu Al
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
