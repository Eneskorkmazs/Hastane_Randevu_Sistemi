    <script>
        (function () {
            async function refreshUnreadNotificationBadge() {
                const unreadBadge = document.getElementById("unreadNotificationBadge");
                const secretaryBadge = document.getElementById("secretaryBadge");

                if (unreadBadge) {
                    try {
                        @if (isDoctor)
                        {
                            <text>const fetchUrl = "@Url.Action("UnreadNotificationCount", "DoctorTools")";</text>
                        }
                        else
                        {
                            <text>const fetchUrl = "@Url.Action("UnreadNotificationCount", "Patient")";</text>
                        }

                        const response = await fetch(fetchUrl, {
                            method: 'GET',
                            cache: 'no-store'
                        });
                        if (response.ok) {
                            const data = await response.json();
                            unreadBadge.textContent = data.count;
                            unreadBadge.style.display = data.count > 0 ? "inline-flex" : "none";
                        }
                    } catch (e) { console.error("Patient badge error", e); }
                }

                if (secretaryBadge) {
                    try {
                        const response = await fetch("@Url.Action("UnreadNotificationCount", "Secretary")", {
                            method: 'GET',
                            cache: 'no-store'
                        });
                        if (response.ok) {
                            const data = await response.json();
                            secretaryBadge.textContent = data.count;
                            secretaryBadge.style.display = data.count > 0 ? "inline-flex" : "none";
                        }
                    } catch (e) { console.error("Secretary badge error", e); }
                }
            }

            refreshUnreadNotificationBadge();
            setInterval(refreshUnreadNotificationBadge, 30000);
        })();
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const themeToggle = document.getElementById('global-theme-toggle');
            if (!themeToggle) return;
            const themeIcon = themeToggle.querySelector('i');
            
            // Sync icon on load
            const currentTheme = document.documentElement.getAttribute('data-theme');
            if (currentTheme === 'dark') {
                themeIcon.className = 'fa-solid fa-sun text-warning';
                document.body.classList.add('dark-mode');
            }

            themeToggle.addEventListener('click', () => {
                themeIcon.classList.add('rotate-360');
                
                setTimeout(() => {
                    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                    const newTheme = isDark ? 'light' : 'dark';
                    
                    document.documentElement.setAttribute('data-theme', newTheme);
                    document.documentElement.setAttribute('data-bs-theme', newTheme);
                    localStorage.setItem('theme', newTheme);
                    
                    if (newTheme === 'dark') {
                        themeIcon.className = 'fa-solid fa-sun text-warning';
                        document.body.classList.add('dark-mode');
                    } else {
                        themeIcon.className = 'fa-solid fa-moon text-white';
                        document.body.classList.remove('dark-mode');
                    }
                    
                    themeIcon.classList.remove('rotate-360');
                }, 250);
            });
        });
    </script>
