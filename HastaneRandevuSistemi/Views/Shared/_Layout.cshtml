@using Microsoft.AspNetCore.Identity
@using HastaneRandevuSistemi.Models
@using Microsoft.EntityFrameworkCore
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject HastaneRandevuSistemi.Data.ApplicationDbContext DbContext

@{
    var unreadNotificationCount = 0;
    var newReviewBadgeCount = 0;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isAccountAuthScreen =
        string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase)
        && (
            string.Equals(currentAction, "Login", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "Register", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "ForgotPassword", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "ForgotPasswordConfirmation", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "ResetPassword", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "ResetPasswordConfirmation", StringComparison.OrdinalIgnoreCase)
        );
    var isAuthenticated = !isAccountAuthScreen && User.Identity?.IsAuthenticated == true;
    var isDoctor = !isAccountAuthScreen && User.IsInRole("Doktor");
    var isPatient = !isAccountAuthScreen && User.IsInRole("Hasta");
    var isAdmin = !isAccountAuthScreen && User.IsInRole("Admin");
    var isSecretary = !isAccountAuthScreen && User.IsInRole("Sekreter");
    var isSignedIn = !isAccountAuthScreen && SignInManager.IsSignedIn(User);

    string GetNavLinkClass(string controller, params string[] actions)
    {
        var isActive = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            && (actions.Length == 0 || Array.Exists(actions, action => string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)));

        return isActive ? "nav-link nav-link-premium is-active" : "nav-link nav-link-premium";
    }

    if (isSignedIn && isPatient)
    {
        var currentUserForCount = await UserManager.GetUserAsync(User);
        if (currentUserForCount != null)
        {
            unreadNotificationCount = await DbContext.Notifications
                .CountAsync(n => n.UserId == currentUserForCount.Id && !n.IsRead);
        }
    }

    if (isSignedIn && isDoctor)
    {
        // Doktor için ek badge hesaplaması gerekirse buraya eklenebilir
    }
    else if (isSignedIn && isAdmin)
    {
        newReviewBadgeCount = await DbContext.HospitalReviews.CountAsync(r => r.AdminReply == null);
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hastane Randevu Sistemi</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script>
        (function () {
            var currentTheme = localStorage.getItem('theme') || "light";
            document.documentElement.setAttribute('data-theme', currentTheme);
            document.documentElement.setAttribute('data-bs-theme', currentTheme);
        })();
    </script>
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow fixed-top" style="background: linear-gradient(90deg, #004e92 0%, #000428 100%);">
            <div class="container">
                @if (isDoctor)
                {
                    <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="DoctorDashboard">
                        <i class="fa-solid fa-user-md me-2"></i> HRS <span class="fw-light small">Doktor Paneli</span>
                    </a>
                }
                else if (isPatient)
                {
                    <a class="navbar-brand fw-bold" asp-area="" asp-controller="Patient" asp-action="Dashboard">
                        <i class="fa-solid fa-heart-pulse me-2"></i> HRS <span class="fw-light small">Hasta Paneli</span>
                    </a>
                }
                else
                {
                    <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-heart-pulse me-2"></i> HRS <span class="fw-light small">Randevu Sistemi</span>
                    </a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Gezinme menüsünü aç veya kapat">
                    <span class="navbar-toggler-icon" aria-hidden="true"></span>
                </button>

                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav nav-main-links flex-grow-1 ms-auto mb-2 mb-lg-0">

                        @if (!isDoctor)
                        {
                            <li class="nav-item">
                                <a class="@GetNavLinkClass("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="fa-solid fa-house-chimney me-1"></i> Ana Sayfa
                                </a>
                            </li>
                        }

                        @if (isPatient)
                        {
                            <li class="nav-item">
                                <a class="@GetNavLinkClass("Patient", "Dashboard")" asp-controller="Patient" asp-action="Dashboard">
                                    <i class="fa-solid fa-gauge-high me-1"></i> Panelim
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@GetNavLinkClass("Patient", "Notifications")" asp-controller="Patient" asp-action="Notifications">
                                    <i class="fa-solid fa-bell me-1"></i> Bildirimler
                                    <span id="unreadNotificationBadge" class="badge rounded-pill bg-danger text-white ms-1 nav-badge-premium" style="@(unreadNotificationCount > 0 ? "display:inline-flex;" : "display:none;")">
                                        @unreadNotificationCount
                                    </span>
                                </a>
                            </li>
                        }

                        @if (isPatient || !isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="@GetNavLinkClass("Appointment", "Create")" asp-controller="Appointment" asp-action="Create">
                                    <i class="fa-solid fa-calendar-plus me-1"></i> Randevu Al
                                </a>
                            </li>
                        }

                        @if (isAuthenticated && !isAdmin && !isDoctor && !isPatient)
                        {
                            <li class="nav-item">
                                <a class="@GetNavLinkClass("Appointment", "Index")" asp-controller="Appointment" asp-action="Index">
                                    @if (isSecretary)
                                    {
                                        <span><i class="fa-solid fa-list-check me-1"></i> Randevu Listesi</span>
                                    }
                                </a>
                            </li>
                        }

                        @if (isSecretary)
                        {
                            <li class="nav-item">
                                <a class="@GetNavLinkClass("Secretary")" asp-controller="Secretary" asp-action="Dashboard">
                                    <i class="fa-solid fa-clipboard-check me-1"></i> Sekreter Paneli
                                </a>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="@GetNavLinkClass("Home", "AdminDashboard")" asp-controller="Home" asp-action="AdminDashboard">
                                    <i class="fa-solid fa-gauge-high me-1"></i> Panel
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-premium dropdown-toggle @(string.Equals(currentController, "Doctor", StringComparison.OrdinalIgnoreCase) || string.Equals(currentController, "Department", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="#" id="navYonetim" role="button" data-bs-toggle="dropdown">
                                    Yönetim
                                </a>
                                <ul class="dropdown-menu border-0 shadow mt-2" aria-labelledby="navYonetim">
                                    <li><a class="dropdown-item" asp-controller="Doctor" asp-action="Index">Doktor Yönetimi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Department" asp-action="Index">Bölüm Yönetimi</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-premium dropdown-toggle @(currentAction.Contains("Analysis") || currentAction.Contains("Insights") || currentAction.Contains("Analytics") ? "is-active" : "")" href="#" id="navAnaliz" role="button" data-bs-toggle="dropdown">
                                    Analizler
                                </a>
                                <ul class="dropdown-menu border-0 shadow mt-2" aria-labelledby="navAnaliz">
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="AdminServiceAnalysis">Hizmet Analizi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="AdminDoctorInsights">Doktor Analizleri</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="AdminAccountingDepartments">Bölüm Analizleri</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="AdminAnalytics">Genel Grafikler</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-premium dropdown-toggle @(currentAction.Contains("Accounting") || currentAction == "Tahsilat" ? "is-active" : "")" href="#" id="navMuhasebe" role="button" data-bs-toggle="dropdown">
                                    Muhasebe
                                </a>
                                <ul class="dropdown-menu border-0 shadow mt-2" aria-labelledby="navMuhasebe">
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="AdminAccounting">Finansal Özet</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="AdminAccountingDoctors">Doktor Muhasebesi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="AdminAccountingPending">Bekleyen Ödemeler</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Tahsilat">Tahsilat Onayı</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-premium dropdown-toggle @(currentAction == "AdminHospitalReviews" || currentAction == "CreateAnnouncement" || currentAction == "AdminReport" ? "is-active" : "")" href="#" id="navSistem" role="button" data-bs-toggle="dropdown">
                                    Sistem
                                    @if (newReviewBadgeCount > 0)
                                    {
                                        <span class="badge rounded-pill bg-danger text-white ms-1" style="font-size: 0.65rem;">@newReviewBadgeCount</span>
                                    }
                                </a>
                                <ul class="dropdown-menu border-0 shadow mt-2" aria-labelledby="navSistem">
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="AdminHospitalReviews">Hasta Yorumları</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="CreateAnnouncement">Duyuru Gönder</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="AdminReport">Sistem Raporları</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav nav-user-actions ms-3 align-items-center">
                        <li class="nav-item me-3">
                            <button id="theme-toggle" class="border-0 shadow-sm" aria-label="Tema değiştir" title="Tema Değiştir">
                                <i class="fa-solid fa-moon"></i>
                                <i class="fa-solid fa-sun text-warning"></i>
                            </button>
                        </li>
                        @if (isSignedIn)
                        {
                            var currentUser = await UserManager.GetUserAsync(User);

                            var displayName = currentUser != null ? $"{currentUser.Name} {currentUser.Surname}" : (User.Identity?.Name ?? "Kullanıcı");

                            <li class="nav-item dropdown">
                                <a class="btn btn-outline-light dropdown-toggle rounded-pill px-3" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-circle-user me-2"></i> @displayName
                                    <br><small style="font-size:0.7em; opacity:0.8;">
                                        @(isAdmin ? "Admin" : isDoctor ? "Doktor" : isSecretary ? "Sekreter" : "Hasta")
                                    </small>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow mt-2">
                                    @if (isPatient)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Patient" asp-action="Dashboard">
                                                <i class="fa-solid fa-gauge-high me-2"></i> Hasta Paneli
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Appointment" asp-action="Index">
                                                <i class="fa-solid fa-calendar-days me-2"></i> Randevularım
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Patient" asp-action="MedicalHistory">
                                                <i class="fa-solid fa-notes-medical me-2"></i> Sağlık Geçmişim
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Patient" asp-action="Profile">
                                                <i class="fa-solid fa-user-pen me-2"></i> Profilim
                                            </a>
                                        </li>
                                        <li>
                                        <a class="dropdown-item" asp-controller="Patient" asp-action="Notifications">
                                            <i class="fa-solid fa-bell me-2"></i> Bildirimler
                                            <span class="badge rounded-pill bg-danger text-white ms-2" style="@(unreadNotificationCount > 0 ? "display:inline-flex;" : "display:none;")">
                                                @unreadNotificationCount
                                            </span>
                                        </a>
                                        </li>
                                                                                                                <li><hr class="dropdown-divider"></li>
                                    }
                                    @if (isDoctor)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Home" asp-action="DoctorDashboard">
                                                <i class="fa-solid fa-chart-line me-2"></i> Doktor Paneli
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="DoctorTools" asp-action="Index">
                                                <i class="fa-solid fa-suitcase-medical me-2"></i> Doktor Araçları
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="DoctorTools" asp-action="Schedule">
                                                <i class="fa-solid fa-calendar-days me-2"></i> Çalışma Takvimi
                                            </a>
                                        </li>
                                                                                                                <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="fa-solid fa-power-off me-2"></i> Çıkış Yap
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white me-2" asp-controller="Account" asp-action="Register">
                                    <i class="fa-solid fa-user-plus me-1"></i> Kayıt Ol
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-light text-primary fw-bold rounded-pill px-4" asp-controller="Account" asp-action="Login">
                                    <i class="fa-solid fa-right-to-bracket me-2"></i> Giriş
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-5 pt-5">
        <main id="main-content" tabindex="-1" role="main" class="@(ViewData["Title"]?.ToString() == "Ana Sayfa" ? "container-fluid p-0" : "container mt-5 pt-5")">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white pt-5 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-uppercase fw-bold mb-3 text-primary"><i class="fa-solid fa-heart-pulse me-2"></i>HRS Hastanesi</h5>
                    <p class="small text-white-50">
                        Modern tıbbın imkanları, uzman kadromuz ve ileri teknolojimizle sağlığınız için 7/24 hizmetinizdeyiz.
                        Randevu sistemimiz ile beklemeden muayene olabilirsiniz.
                    </p>
                    <div class="mt-3">
                        <a href="https://github.com/Eneskorkmazs" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub profilini aç"><i class="fa-brands fa-github" aria-hidden="true"></i></a>
                        <a href="https://www.instagram.com/enes_korkmazs_/#" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram profilini aç"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
                        <a href="https://www.linkedin.com/in/enes-korkmaz-436a92340/" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn profilini aç"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-uppercase fw-bold mb-3">Hızlı Erişim</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/" class="footer-link"><i class="fa-solid fa-angle-right me-2 text-primary"></i>Ana Sayfa</a></li>
                        <li class="mb-2"><a href="/Appointment/Create" class="footer-link"><i class="fa-solid fa-angle-right me-2 text-primary"></i>Randevu Al</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-uppercase fw-bold mb-3">İletişim</h5>
                    <ul class="list-unstyled small text-white-50">
                        <li class="mb-3">
                            <i class="fa-solid fa-location-dot me-2 text-primary fa-lg"></i>
                            Şanlıurfa
                        </li>
                        <li class="mb-3">
                            <i class="fa-solid fa-phone me-2 text-primary fa-lg"></i>
                            +90 543 870 96 57
                        </li>
                        <li class="mb-3">
                            <i class="fa-solid fa-envelope me-2 text-primary fa-lg"></i>
                            info@havatakip.com.tr
                        </li>
                        <li>
                            <i class="fa-solid fa-clock me-2 text-primary fa-lg"></i>
                            7/24 Acil Servis
                        </li>
                    </ul>
                </div>
            </div>

            <hr class="mb-4 border-secondary">

            <div class="row align-items-center pb-4">
                <div class="col-md-7 col-lg-8 text-center text-md-start">
                    <div class="p-3">
                        &copy; 2026 <strong class="text-primary">HRS Hastanesi</strong>. Tüm Hakları Saklıdır.
                    </div>
                </div>
                <div class="col-md-5 col-lg-4 text-center text-md-end">
                    <a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none me-3 small">Gizlilik Politikası</a>
                    <a asp-controller="Home" asp-action="Terms" class="text-white-50 text-decoration-none small">Kullanım Şartları</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            const unreadBadge = document.getElementById("unreadNotificationBadge");
            if (!unreadBadge) {
                return;
            }

            async function refreshUnreadNotificationBadge() {
                try {
                    const response = await fetch("@Url.Action("UnreadNotificationCount", "Patient")", {
                        method: "GET",
                        credentials: "same-origin"
                    });

                    if (!response.ok) {
                        return;
                    }

                    const payload = await response.json();
                    const count = Number(payload.count || 0);
                    unreadBadge.textContent = String(count);
                    unreadBadge.style.display = count > 0 ? "inline-flex" : "none";
                } catch {
                    // ignore transient errors
                }
            }

            refreshUnreadNotificationBadge();
            setInterval(refreshUnreadNotificationBadge, 30000);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
