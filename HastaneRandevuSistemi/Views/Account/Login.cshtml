@model HastaneRandevuSistemi.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5" style="max-width: 760px;">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header text-white p-4 p-md-5 login-hero">
            <div class="d-flex align-items-start justify-content-between gap-3">
                <div>
                    <div class="text-uppercase small fw-bold text-white-50 mb-2">HRS Giriş</div>
                    <h1 class="h3 fw-bold mb-2">Hesap türünüzü seçin</h1>
                    <p class="mb-0 text-white-50">
                        Hasta veya doktor kartına dokunduğunuzda giriş alanları açılır.
                        Admin hesapları aynı giriş ekranından otomatik algılanır.
                    </p>
                </div>
                <div class="auth-icon">
                    <i class="fa-solid fa-right-to-bracket"></i>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" id="loginForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4"></div>

                <input asp-for="SelectedRole" type="hidden" id="SelectedRole" />

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap mb-3">
                        <label class="form-label fw-semibold mb-0">Giriş türü seçin</label>
                        <button type="button" id="changeRoleBtn" class="btn btn-link p-0 text-decoration-none fw-semibold d-none">
                            Seçimi değiştir
                        </button>
                    </div>

                    <div class="row g-3" id="rolePickerRow">
                        <div class="col-md-6">
                            <button type="button" class="entry-card patient-card w-100 text-start" data-role="Hasta">
                                <span class="entry-emoji patient">🩺</span>
                                <span class="entry-content">
                                    <strong>Hasta olarak giriş yap</strong>
                                    <small class="entry-selected">Seçildi</small>
                                </span>
                            </button>
                        </div>
                        <div class="col-md-6">
                            <button type="button" class="entry-card doctor-card w-100 text-start" data-role="Doktor">
                                <span class="entry-emoji doctor">👨‍⚕️</span>
                                <span class="entry-content">
                                    <strong>Doktor olarak giriş yap</strong>
                                    <small class="entry-selected">Seçildi</small>
                                </span>
                            </button>
                        </div>
                    </div>

                    <div class="mt-3 small text-muted">
                        Not: Admin hesabı e-posta ve şifre ile aynı ekrandan giriş yapar. Rol kontrolü sistem tarafından otomatik yapılır.
                    </div>
                </div>

                <div id="credentialsPanel" class="credentials-panel d-none">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control form-control-lg" placeholder="ornek@mail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <div class="input-group input-group-lg">
                                <input asp-for="Password" type="password" class="form-control" placeholder="Şifreniz" id="loginPassword" />
                                <button type="button" id="toggleLoginPassword" class="btn btn-outline-secondary" tabindex="-1" aria-label="Şifreyi göster / gizle">
                                    <i class="fa-solid fa-eye" id="loginPasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="RememberMe" />
                                <label class="form-check-label" asp-for="RememberMe">Beni Hatırla</label>
                            </div>
                            <a asp-action="ForgotPassword" class="small fw-semibold text-decoration-none">Şifremi unuttum</a>
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3 login-submit">
                                <i class="fa-solid fa-right-to-bracket me-2"></i> Giriş Yap
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="card-footer bg-light text-center py-3 border-0">
            <span class="text-muted small">Hesabınız yok mu?</span>
            <a asp-action="Register" class="fw-bold text-decoration-none ms-1">Hasta kaydı oluşturun</a>
        </div>
    </div>
</div>

<style>
    .login-hero {
        background: linear-gradient(135deg, #0b3b66 0%, #031c33 100%);
    }

    .auth-icon {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
        background: rgba(255, 255, 255, 0.12);
        flex-shrink: 0;
    }

    .entry-card {
        width: 100%;
        min-height: 92px;
        border: 1px solid #dbe5ef;
        border-radius: 20px;
        background: #f8fbff;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        cursor: pointer;
        transition: all 0.22s ease;
        outline: none;
        text-align: left;
        position: relative;
        overflow: hidden;
    }

    .entry-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 32px rgba(15, 41, 75, 0.12);
    }

    .entry-card.active {
        transform: translateY(-3px) scale(1.02);
        box-shadow: 0 20px 40px rgba(11, 92, 173, 0.16);
        border-width: 2px;
    }

    .patient-card {
        border-color: #aab9c8;
        background: linear-gradient(135deg, #f7fbff 0%, #e8f0f7 100%);
    }

    .patient-card.active {
        border-color: #0b3b66;
        box-shadow: 0 0 0 4px rgba(11, 59, 102, 0.12);
    }

    .doctor-card {
        border-color: #0b3b66;
        background: linear-gradient(135deg, #f3f8fd 0%, #dfe9f4 100%);
    }

    .doctor-card.active {
        border-color: #031c33;
        box-shadow: 0 0 0 4px rgba(3, 28, 51, 0.14);
    }

    .entry-card.hidden-choice {
        opacity: 0;
        transform: scale(0.94);
        pointer-events: none;
    }

    .entry-card::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,.18), transparent 35%);
        pointer-events: none;
    }

    .entry-emoji {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        font-size: 1.6rem;
        background: rgba(255, 255, 255, 0.85);
        flex-shrink: 0;
    }

    .entry-emoji.patient {
        color: #0b3b66;
    }

    .entry-emoji.doctor {
        color: #031c33;
    }

    .entry-card strong {
        display: block;
        font-size: 1rem;
        line-height: 1.2;
    }

    .entry-content {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .entry-selected {
        display: inline-flex;
        align-self: flex-start;
        padding: 0.18rem 0.55rem;
        border-radius: 999px;
        background: rgba(11, 59, 102, 0.12);
        color: #0b3b66;
        font-weight: 700;
        font-size: 0.72rem;
        letter-spacing: 0.02em;
        opacity: 0;
        transform: translateY(2px);
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .entry-card.active .entry-selected {
        opacity: 1;
        transform: translateY(0);
    }

    .credentials-panel {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #e5edf5;
        animation: fadeInUp 0.22s ease;
    }

    .login-submit {
        background: linear-gradient(90deg, #0b5cad 0%, #082847 100%);
        border: none;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const form = document.getElementById("loginForm");
            const input = document.getElementById("loginPassword");
            const button = document.getElementById("toggleLoginPassword");
            const icon = document.getElementById("loginPasswordIcon");
            const cards = document.querySelectorAll(".entry-card");
            const roleField = document.getElementById("SelectedRole");
            const credentialsPanel = document.getElementById("credentialsPanel");
            const changeRoleBtn = document.getElementById("changeRoleBtn");

            const collapseOtherChoices = (selectedRole) => {
                cards.forEach(card => {
                    const role = card.getAttribute("data-role");
                    card.classList.toggle("hidden-choice", role !== selectedRole);
                });

                if (changeRoleBtn) {
                    changeRoleBtn.classList.remove("d-none");
                }
            };

            const resetRoleSelection = () => {
                cards.forEach(card => card.classList.remove("hidden-choice", "active"));

                if (roleField) {
                    roleField.value = "";
                }

                if (credentialsPanel) {
                    credentialsPanel.classList.add("d-none");
                }

                if (changeRoleBtn) {
                    changeRoleBtn.classList.add("d-none");
                }
            };

            const applyRole = (role) => {
                if (!role) {
                    return;
                }

                cards.forEach(card => {
                    const cardRole = card.getAttribute("data-role");
                    card.classList.toggle("active", cardRole === role);
                });

                if (roleField) {
                    roleField.value = role;
                }

                if (credentialsPanel) {
                    credentialsPanel.classList.remove("d-none");
                }

                collapseOtherChoices(role);
            };

            if (input && button && icon) {
                button.addEventListener("click", function () {
                    const isPassword = input.type === "password";
                    input.type = isPassword ? "text" : "password";
                    icon.className = isPassword ? "fa-solid fa-eye-slash" : "fa-solid fa-eye";
                });
            }

            cards.forEach(card => {
                card.addEventListener("click", () => {
                    const role = card.getAttribute("data-role");
                    applyRole(role);
                });
            });

            if (changeRoleBtn) {
                changeRoleBtn.addEventListener("click", resetRoleSelection);
            }

            if (form) {
                form.addEventListener("submit", () => {
                    if (!roleField) {
                        return;
                    }

                    if (!roleField.value) {
                        const activeCard = document.querySelector(".entry-card.active");
                        const activeRole = activeCard?.getAttribute("data-role");
                        roleField.value = activeRole || "Hasta";
                    }
                });
            }

            if (roleField && roleField.value && credentialsPanel) {
                applyRole(roleField.value);
            }
        })();
    </script>
}
