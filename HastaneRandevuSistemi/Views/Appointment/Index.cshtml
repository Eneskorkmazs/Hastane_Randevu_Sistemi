@model IEnumerable<HastaneRandevuSistemi.Models.Appointment>

@{
    bool isHasta = User.IsInRole("Hasta");
    bool isAdmin = User.IsInRole("Admin");
    bool isDoctor = User.IsInRole("Doktor");
    ViewData["Title"] = isHasta ? "Randevu Geçmişim" : "Randevu Listesi";
    var statusOptions = ViewData["StatusOptions"] as IEnumerable<SelectListItem>;
    var doctorOptions = ViewData["DoctorOptions"] as IEnumerable<SelectListItem>;
    var departmentOptions = ViewData["DepartmentOptions"] as IEnumerable<SelectListItem>;
    var selectedStatus = ViewData["SelectedStatus"]?.ToString();
    var searchTerm = ViewData["SearchTerm"] as string;
    var selectedDoctorId = ViewData["DoctorId"]?.ToString();
    var selectedDepartmentId = ViewData["DepartmentId"]?.ToString();
    var fromDate = ViewData["FromDate"] as string;
    var toDate = ViewData["ToDate"] as string;
    var selectedSortBy = ViewData["SortBy"]?.ToString();
    var onlyUpcoming = ViewData["OnlyUpcoming"] as bool? == true;
    var today = DateTime.Today;
    var todayText = today.ToString("yyyy-MM-dd");
    var next7Text = today.AddDays(7).ToString("yyyy-MM-dd");
    var next30Text = today.AddDays(30).ToString("yyyy-MM-dd");
    var totalCount = Model.Count();
    var pendingCount = Model.Count(x => x.Status == AppointmentStatus.Bekliyor);
    var completedCount = Model.Count(x => x.Status == AppointmentStatus.Tamamlandi);
    var paidCount = Model.Count(x => x.IsCollected);
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm rounded-4" role="alert">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-primary"><i class="fa-solid fa-calendar-check me-2"></i>@ViewData["Title"]</h2>
            <p class="text-muted mb-0">@(isHasta ? "Geçmiş ve yaklaşan tüm randevularınız." : "Randevuları filtreleyip yönetin.")</p>
        </div>
        <div class="d-flex gap-2">
            @if (isHasta)
            {
                <a asp-controller="Patient" asp-action="Dashboard" class="btn btn-outline-primary rounded-pill px-4">Panele Dön</a>
            }
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fa fa-plus me-2"></i>Yeni Randevu
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="text-muted small">Liste Kaydı</div>
                    <div class="h3 fw-bold mb-0">@totalCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="text-muted small">Bekleyen</div>
                    <div class="h3 fw-bold text-warning mb-0">@pendingCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="text-muted small">Tamamlanan</div>
                    <div class="h3 fw-bold text-primary mb-0">@completedCount</div>
                </div>
            </div>
        </div>
        @if (isAdmin)
        {
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <div class="text-muted small">Ödeme Alınan</div>
                        <div class="h3 fw-bold text-success mb-0">@paidCount</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label">Durum</label>
                    <select name="status" class="form-select">
                        <option value="">Tüm Durumlar</option>
                        @if (statusOptions != null)
                        {
                            foreach (var item in statusOptions)
                            {
                                <option value="@item.Value" selected="@(item.Value == selectedStatus)">@item.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Poliklinik</label>
                    <select name="departmentId" class="form-select">
                        <option value="">Tüm Poliklinikler</option>
                        @if (departmentOptions != null)
                        {
                            foreach (var item in departmentOptions)
                            {
                                <option value="@item.Value" selected="@(item.Value == selectedDepartmentId)">@item.Text</option>
                            }
                        }
                    </select>
                </div>

                @if (!isHasta)
                {
                    <div class="col-12 col-md-3">
                        <label class="form-label">Doktor</label>
                        <select name="doctorId" class="form-select">
                            <option value="">Tüm Doktorlar</option>
                            @if (doctorOptions != null)
                            {
                                foreach (var item in doctorOptions)
                                {
                                    <option value="@item.Value" selected="@(item.Value == selectedDoctorId)">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                }

                <div class="col-12 col-md-3">
                    <label class="form-label">Başlangıç</label>
                    <input type="date" name="fromDate" value="@fromDate" class="form-control" />
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Bitiş</label>
                    <input type="date" name="toDate" value="@toDate" class="form-control" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Arama</label>
                    <input type="text" name="search" value="@searchTerm" class="form-control" placeholder="Hasta, doktor veya bölüm" />
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Sıralama</label>
                    <select name="sortBy" class="form-select">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(selectedSortBy))">En yeni tarih</option>
                        <option value="date_asc" selected="@(selectedSortBy == "date_asc")">En yakın tarih</option>
                        <option value="status" selected="@(selectedSortBy == "status")">Duruma göre</option>
                        <option value="doctor" selected="@(selectedSortBy == "doctor")">Doktora göre</option>
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <div class="form-check mt-4 pt-2">
                        <input class="form-check-input" type="checkbox" name="onlyUpcoming" value="true" id="onlyUpcoming" checked="@onlyUpcoming" />
                        <label class="form-check-label" for="onlyUpcoming">Sadece gelecek randevular</label>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">Hızlı tarih aralığı</label>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Index" asp-route-fromDate="@todayText" asp-route-toDate="@todayText" class="btn btn-outline-secondary btn-sm rounded-pill">Bugün</a>
                        <a asp-action="Index" asp-route-fromDate="@todayText" asp-route-toDate="@next7Text" class="btn btn-outline-secondary btn-sm rounded-pill">Sonraki 7 gün</a>
                        <a asp-action="Index" asp-route-fromDate="@todayText" asp-route-toDate="@next30Text" class="btn btn-outline-secondary btn-sm rounded-pill">Sonraki 30 gün</a>
                    </div>
                </div>

                <div class="col-12 col-md-6 d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Filtrele</button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body py-5 text-center">
                <div class="text-muted mb-3"><i class="fa-regular fa-calendar-xmark fa-4x"></i></div>
                <h4>Kayıt bulunamadı.</h4>
            </div>
        </div>
    }
    else
    {
        <div class="d-md-none">
            @foreach (var item in Model)
            {
                var canPatientCancel = isHasta && item.AppointmentDate > DateTime.Now && item.Status != AppointmentStatus.Iptal && item.Status != AppointmentStatus.Tamamlandi;
                var isFutureApprovedAppointment = item.Status == AppointmentStatus.Onaylandi && item.AppointmentDate > DateTime.Now;
                var adminCanManage = true;
                var isPastAppointment = item.AppointmentDate <= DateTime.Now;
                var canAdminCompletePastAppointment = isAdmin && isPastAppointment && item.Status != AppointmentStatus.Iptal && item.Status != AppointmentStatus.Tamamlandi;
                <div class="card shadow-sm mb-3 border-0 rounded-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                            <span class="fw-bold text-dark">@item.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</span>
                            <span class="badge rounded-pill @(item.Status switch {
                                AppointmentStatus.Bekliyor => "bg-warning text-dark",
                                AppointmentStatus.Onaylandi => "bg-success",
                                AppointmentStatus.Iptal => "bg-danger",
                                _ => "bg-primary"
                            })">@item.Status</span>
                        </div>
                        @if (item.Status == AppointmentStatus.Iptal && !string.IsNullOrWhiteSpace(item.CancelledByName))
                        {
                            <div class="small text-muted mb-2">İptal eden: @item.CancelledByName</div>
                        }
                        @if (isAdmin && item.IsCollected)
                        {
                            <div class="small text-success mb-2">Ödeme alındı</div>
                        }

                        <h5 class="card-title fw-bold text-primary">@($"{item.Doctor?.Title} {item.Doctor?.Name} {item.Doctor?.Surname}".Trim())</h5>
                        <p class="small text-muted mb-1">@item.Doctor?.Department?.Name</p>


                        <div class="d-grid gap-2 mt-3">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info rounded-pill w-100">
                                <i class="fa-solid fa-notes-medical me-2"></i>Tıbbi Dosyalar
                            </a>
                            <button type="button" class="btn btn-outline-primary rounded-pill w-100" data-bs-toggle="modal" data-bs-target="#qrModal-@item.Id">
                                <i class="fa-solid fa-qrcode me-2"></i>QR Bilet Göster
                            </button>
                            @if (isHasta)
                            {
                                if (canPatientCancel)
                                {
                                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu randevuyu iptal etmek istiyor musunuz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger rounded-pill w-100">Randevuyu İptal Et</button>
                                    </form>
                                }
                            }
                            else
                            {
                                @if (!isDoctor)
                                {
                                    if (item.Status == AppointmentStatus.Bekliyor)
                                    {
                                        <div class="btn-group w-100">
                                            <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success" disabled="@(!adminCanManage)">Onayla</button>
                                            </form>
                                            <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu randevuyu reddetmek istiyor musunuz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger" disabled="@(!adminCanManage)">Reddet</button>
                                            </form>
                                        </div>
                                    }
                                    else if (item.Status == AppointmentStatus.Onaylandi)
                                    {
                                        <div class="btn-group w-100">
                                            @if (isFutureApprovedAppointment)
                                            {
                                                <button type="button" class="btn btn-secondary" disabled title="Randevu zamanı gelince tamamlanabilir">
                                                    Bekleniyor
                                                </button>
                                            }
                                            else
                                            {
                                                <form asp-action="Complete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-primary" disabled="@(!adminCanManage)">Tamamla</button>
                                                </form>
                                            }
                                            <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu randevuyu iptal etmek istiyor musunuz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" disabled="@(!adminCanManage)">İptal</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-grid gap-2">
                                            @if (canAdminCompletePastAppointment)
                                            {
                                                <form asp-action="Complete" asp-route-id="@item.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-primary rounded-pill w-100">Randevu Tamamlandı</button>
                                                </form>
                                            }
                                            @if (!canAdminCompletePastAppointment)
                                            {
                                                <span class="badge bg-light text-secondary border w-100 py-2">Kayıt kapalı</span>
                                            }
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-none d-md-block">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="py-3 ps-4">Tarih</th>
                                @if (!isHasta)
                                {
                                    <th>Hasta</th>
                                }
                                <th>Doktor</th>
                                <th>Durum</th>
                                <th class="text-end pe-4">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var canPatientCancel = isHasta && item.AppointmentDate > DateTime.Now && item.Status != AppointmentStatus.Iptal && item.Status != AppointmentStatus.Tamamlandi;
                                var isFutureApprovedAppointment = item.Status == AppointmentStatus.Onaylandi && item.AppointmentDate > DateTime.Now;
                                var isPastAppointment = item.AppointmentDate <= DateTime.Now;
                                var canAdminCompletePastAppointment = isAdmin && isPastAppointment && item.Status != AppointmentStatus.Iptal && item.Status != AppointmentStatus.Tamamlandi;
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-bold d-block">@item.AppointmentDate.ToString("dd.MM.yyyy")</span>
                                        <span class="small text-muted">@item.AppointmentDate.ToString("HH:mm")</span>
                                    </td>
                                    @if (!isHasta)
                                    {
                                        <td>@item.PatientName @item.PatientSurname</td>
                                    }
                                    <td>
                                        <span class="fw-bold d-block">@($"{item.Doctor?.Title} {item.Doctor?.Name} {item.Doctor?.Surname}".Trim())</span>
                                        <span class="badge bg-light text-secondary border">@item.Doctor?.Department?.Name</span>

                                    </td>
                                    <td>
                                        <span class="badge rounded-pill @(item.Status switch {
                                            AppointmentStatus.Bekliyor => "bg-warning text-dark",
                                            AppointmentStatus.Onaylandi => "bg-success",
                                            AppointmentStatus.Iptal => "bg-danger",
                                            _ => "bg-primary"
                                        })">@item.Status</span>
                                        @if (item.Status == AppointmentStatus.Iptal && !string.IsNullOrWhiteSpace(item.CancelledByName))
                                        {
                                            <div class="small text-muted mt-1">İptal eden: @item.CancelledByName</div>
                                        }
                                        @if (isAdmin && item.IsCollected)
                                        {
                                            <div class="small text-success mt-1">Ödeme alındı</div>
                                        }

                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill me-2" title="Tıbbi Dosyalar">
                                            <i class="fa-solid fa-notes-medical"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill me-2" data-bs-toggle="modal" data-bs-target="#qrModal-@item.Id" title="QR Bilet">
                                            <i class="fa-solid fa-qrcode"></i>
                                        </button>
                                        @if (isHasta)
                                        {
                                            if (canPatientCancel)
                                            {
                                                <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu randevuyu iptal etmek istiyor musunuz?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">İptal Et</button>
                                                </form>
                                            }
                                        }
                                        else
                                        {
                                            @if (!isDoctor)
                                            {
                                                if (item.Status == AppointmentStatus.Bekliyor)
                                                {
                                                    <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-success" title="Onayla"><i class="fa-solid fa-check"></i></button>
                                                    </form>
                                                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu randevuyu reddetmek istiyor musunuz?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-danger" title="Reddet"><i class="fa-solid fa-xmark"></i></button>
                                                    </form>
                                                }
                                                else if (item.Status == AppointmentStatus.Onaylandi)
                                                {
                                                    @if (isFutureApprovedAppointment)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-secondary" title="Randevu zamanı bekleniyor" disabled>Bekleniyor</button>
                                                    }
                                                    else
                                                    {
                                                        <form asp-action="Complete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-primary" title="Tamamla">
                                                                <i class="fa-solid fa-clipboard-check"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu randevuyu iptal etmek istiyor musunuz?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="İptal"><i class="fa-solid fa-ban"></i></button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    if (canAdminCompletePastAppointment)
                                                    {
                                                        <form asp-action="Complete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill" title="Randevu Tamamlandı">
                                                                <i class="fa-solid fa-clipboard-check"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (User.IsInRole("Sekreter") && item.Status == AppointmentStatus.Tamamlandi && item.PrescriptionCreatedAt == null)
                                                    {
                                                        <a asp-controller="Secretary" asp-action="Prescription" asp-route-appointmentId="@item.Id"
                                                           class="btn btn-sm btn-success rounded-pill ms-1" title="Reçete Yaz">
                                                            <i class="fa-solid fa-file-prescription"></i>
                                                        </a>
                                                    }
                                                    else if (User.IsInRole("Sekreter") && item.Status == AppointmentStatus.Tamamlandi && item.PrescriptionCreatedAt != null)
                                                    {
                                                        <span class="badge bg-success rounded-pill ms-1" title="Reçete yazıldı">
                                                            <i class="fa-solid fa-check me-1"></i>Reçete
                                                        </span>
                                                    }
                                                    if (!canAdminCompletePastAppointment && item.Status != AppointmentStatus.Tamamlandi)
                                                    {
                                                        <span class="badge bg-light text-secondary border">Kayıt kapalı</span>
                                                    }
                                                }
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@foreach(var item in Model) {
    <div class="modal fade" id="qrModal-@item.Id" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
          <div class="modal-header border-0 bg-light rounded-top-4">
            <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-qrcode me-2"></i>Randevu QR Bileti</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-center p-4">
            <div class="alert alert-info py-2 px-3 small border-0 text-start shadow-sm rounded-3 mb-3">
                <strong><i class="fa-solid fa-circle-info me-1"></i>Bu QR Kod Ne İşe Yarar?</strong><br/>
                <span class="text-muted">Hastaneye geldiğinizde, sıranızı hızlıca almak ve kaydınızı otomatik onaylatmak için bu kodu hasta kabul bankosundaki görevliye veya hastane girişindeki kiosk cihazlarına okutabilirsiniz. Böylece beklemeden doğrudan doktorunuzun kapısına yönelebilirsiniz.</span>
            </div>
            <img src="@Url.Action("GetQrTicket", "Appointment", new { id = item.Id })" class="img-fluid rounded shadow-sm border p-2" alt="QR Kod">
            <h6 class="mt-3 fw-bold text-primary mb-0">@item.PatientName @item.PatientSurname</h6>
            <div class="text-muted small">@item.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</div>
          </div>
        </div>
      </div>
    </div>
}
