@model HastaneRandevuSistemi.Models.Appointment

@{
    ViewData["Title"] = "Randevu Al";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="row g-4 align-items-stretch">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="card-body p-4">
                            <span class="eyebrow text-primary">Randevu Akışı</span>
                            <h3 class="fw-bold mb-3">3 adımda randevu oluşturun</h3>
                            <div class="timeline-mini">
                                <div>
                                    <strong>1</strong>
                                    <p>Poliklinik ve doktor seçin.</p>
                                </div>
                                <div>
                                    <strong>2</strong>
                                    <p>Tarih ve saat uygunluğunu kontrol edin.</p>
                                </div>
                                <div>
                                    <strong>3</strong>
                                    <p>Hasta bilgilerinizi onaylayıp kaydedin.</p>
                                </div>
                            </div>
                            <div class="soft-note mt-4">
                                <i class="fa-solid fa-bell me-2"></i>
                                Oluşturduğunuz randevu hasta panelinizde ve bildirim kutunuzda görünür.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                        <div class="card-header auth-header text-white p-4">
                            <h4 class="mb-1 fw-bold"><i class="fa-solid fa-calendar-check me-2"></i>Yeni Randevu Oluştur</h4>
                            <p class="small opacity-75 mb-0">Lütfen bilgileri eksiksiz doldurunuz.</p>
                        </div>

                        <div class="card-body p-4 p-md-5">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small" role="alert"></div>

                            <form asp-action="Create" id="appointmentForm">
                                <div class="mb-4">
                                    <label class="form-label fw-bold text-secondary small">POLİKLİNİK</label>
                                    <div class="input-group shadow-sm">
                                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-hospital text-success"></i></span>
                                        <select id="DepartmentSelect" class="form-select border-start-0 ps-0" asp-items="ViewBag.DepartmentId">
                                            <option value="">-- Önce poliklinik seçin --</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="DoctorId" class="form-label fw-bold text-secondary small">DOKTOR</label>
                                    <div class="input-group shadow-sm">
                                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-user-doctor text-primary"></i></span>
                                        <select asp-for="DoctorId" class="form-select border-start-0 ps-0" id="DoctorSelect" disabled>
                                            <option value="">-- Önce poliklinik seçin --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="DoctorId" class="text-danger x-small mt-1 d-block"></span>
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-secondary small">TARİH</label>
                                        <div class="input-group shadow-sm">
                                            <span class="input-group-text bg-white border-end-0"><i class="fa-regular fa-calendar-days text-primary"></i></span>
                                            <input type="date" id="DatePicker" class="form-control border-start-0 ps-0" min="@DateTime.Now.ToString("yyyy-MM-dd")" disabled />
                                        </div>
                                        <small id="doctorScheduleNote" class="text-muted d-block mt-2">Doktor seçildiğinde uygun gün planı burada gösterilir.</small>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-secondary small">SAAT</label>
                                        <div class="input-group shadow-sm">
                                            <span class="input-group-text bg-white border-end-0"><i class="fa-regular fa-clock text-primary"></i></span>
                                            <select id="TimeSelect" class="form-select border-start-0 ps-0" disabled>
                                                <option value="">-- Önce tarih ve doktor seçin --</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <small id="statusMsg" class="fw-semibold mt-n2 mb-4 d-block"></small>
                                <div id="availabilityPreview" class="availability-preview d-none mb-4">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                        <strong class="text-secondary small">HAFTALIK PLAN</strong>
                                        <span class="small text-muted">12:00 - 13:00 öğle arası kapalıdır</span>
                                    </div>
                                    <div class="mb-3">
                                        <div class="small text-muted mb-2">Çalışma günleri</div>
                                        <div id="availabilityDays" class="d-flex flex-wrap gap-2"></div>
                                    </div>
                                    <div>
                                        <div class="small text-muted mb-2">Müsait saatler</div>
                                        <div id="availabilityHours" class="d-flex flex-wrap gap-2"></div>
                                    </div>
                                </div>
                                <div id="slotSuggestions" class="mb-4 d-none">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                        <strong class="text-secondary small">HIZLI ÖNERİLER</strong>
                                        <span class="small text-muted">En yakın müsait 5 slot</span>
                                    </div>
                                    <div id="slotSuggestionButtons" class="d-flex flex-wrap gap-2"></div>
                                </div>
                                <input type="hidden" asp-for="AppointmentDate" id="FinalDate" />

                                <div class="patient-mini-card p-3 p-md-4 mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6 class="text-primary fw-bold mb-0"><i class="fa-solid fa-id-card me-2"></i>Hasta Bilgileri</h6>
                                        <span class="small text-muted">Profilinizden otomatik dolduruldu</span>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="PatientName" class="form-label small fw-semibold">Ad</label>
                                            <input asp-for="PatientName" class="form-control" value="@ViewBag.PatientName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="PatientSurname" class="form-label small fw-semibold">Soyad</label>
                                            <input asp-for="PatientSurname" class="form-control" value="@ViewBag.PatientSurname" />
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="PatientPhone" class="form-label small fw-semibold">Telefon</label>
                                            <input asp-for="PatientPhone" class="form-control" value="@ViewBag.PatientPhone" placeholder="05xx xxx xx xx" />
                                        </div>
                                    </div>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary btn-lg auth-submit" id="btnSave">
                                        <i class="fa-solid fa-circle-check me-2"></i>Randevuyu Onayla
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-header {
        background: linear-gradient(135deg, #0b3b66 0%, #031c33 100%);
    }

    .eyebrow {
        display: inline-block;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .timeline-mini {
        display: grid;
        gap: 1rem;
    }

    .timeline-mini div {
        position: relative;
        padding-left: 3rem;
    }

    .timeline-mini strong {
        position: absolute;
        left: 0;
        top: 0;
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        display: grid;
        place-items: center;
        color: #0b5cad;
        background: rgba(11, 92, 173, 0.12);
    }

    .timeline-mini p {
        margin: 0;
        color: #516170;
    }

    .soft-note {
        border-radius: 18px;
        padding: 1rem 1.1rem;
        background: #eef6ff;
        color: #214e74;
    }

    .patient-mini-card {
        border-radius: 22px;
        background: linear-gradient(180deg, #f8fbff 0%, #eef5fd 100%);
        border: 1px solid #dce8f5;
    }

    .auth-submit {
        border: none;
        border-radius: 999px;
        padding: 0.95rem 1.5rem;
        background: linear-gradient(90deg, #0b5cad 0%, #082847 100%);
        box-shadow: 0 16px 35px rgba(11, 92, 173, 0.24);
    }

    #slotSuggestionButtons .btn {
        border-width: 1px;
        background: #fff;
        color: #0b5cad;
        border-color: #b8d2ee;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    #slotSuggestionButtons .btn:hover,
    #slotSuggestionButtons .btn:focus {
        background: #eaf4ff;
        color: #083761;
        border-color: #0b5cad;
        box-shadow: 0 10px 20px rgba(11, 92, 173, 0.16);
        transform: translateY(-1px);
    }

    #slotSuggestionButtons .btn:active {
        background: #dcecff;
        color: #082847;
    }

    .availability-preview {
        padding: 1rem 1.1rem;
        border-radius: 18px;
        border: 1px solid #d9e6f3;
        background: linear-gradient(180deg, #fbfdff 0%, #f1f7fd 100%);
    }

    .availability-chip {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 0.45rem 0.8rem;
        font-size: 0.85rem;
        font-weight: 600;
        border: 1px solid #d7e4f2;
        background: #fff;
        color: #214e74;
    }

    .availability-chip.day {
        background: rgba(11, 92, 173, 0.08);
        color: #0b5cad;
    }

    .availability-chip.hour {
        background: rgba(25, 135, 84, 0.08);
        color: #1f6f46;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            const $deptSelect = $("#DepartmentSelect");
            const $doctorSelect = $("#DoctorSelect");
            const $datePicker = $("#DatePicker");
            const $timeSelect = $("#TimeSelect");
            const $msgBox = $("#statusMsg");
            const $finalInput = $("#FinalDate");
            const $suggestions = $("#slotSuggestions");
            const $suggestionButtons = $("#slotSuggestionButtons");
            const $scheduleNote = $("#doctorScheduleNote");
            const $availabilityPreview = $("#availabilityPreview");
            const $availabilityDays = $("#availabilityDays");
            const $availabilityHours = $("#availabilityHours");
            let doctorAvailability = null;

            let preselectedDeptId = '@(ViewBag.PreselectedDepartmentId ?? "")';
            let preselectedDoctorId = '@(Model?.DoctorId ?? 0)';
            let preselectedDate = '@(Model?.AppointmentDate != null && Model.AppointmentDate != DateTime.MinValue ? Model.AppointmentDate.ToString("yyyy-MM-dd") : "")';
            let preselectedTime = '@(Model?.AppointmentDate != null && Model.AppointmentDate != DateTime.MinValue ? Model.AppointmentDate.ToString("HH:mm") : "")';

            if (preselectedDeptId) {
                $deptSelect.val(preselectedDeptId);
                setTimeout(() => $deptSelect.trigger('change'), 100);
            }

            $deptSelect.change(function () {
                const deptId = $(this).val();
                $doctorSelect.empty().append('<option value="">-- Yükleniyor... --</option>').prop("disabled", true);
                $datePicker.val("").prop("disabled", true);
                doctorAvailability = null;
                $scheduleNote.text("Doktor seçildiğinde uygun gün planı burada gösterilir.");
                renderAvailability(null);
                resetTimeSelect();

                if (!deptId) {
                    $doctorSelect.empty().append('<option value="">-- Önce poliklinik seçin --</option>');
                    return;
                }

                $.ajax({
                    url: "/Appointment/GetDoctorsByDepartment",
                    type: "GET",
                    data: { departmentId: deptId },
                    success: function (doctors) {
                        $doctorSelect.empty().append('<option value="">-- Doktor seçiniz --</option>');
                        if (!doctors || doctors.length === 0) {
                            $doctorSelect.append("<option disabled>Bu bölümde doktor bulunamadı.</option>");
                        } else {
                            $.each(doctors, function (_, doctor) {
                                const docId = doctor.id ?? doctor.Id;
                                const docName = doctor.name ?? doctor.Name;
                                $doctorSelect.append($("<option></option>").val(docId).html(docName));
                            });
                            $doctorSelect.prop("disabled", false);

                            if (preselectedDoctorId && preselectedDoctorId !== '0') {
                                $doctorSelect.val(preselectedDoctorId);
                                setTimeout(() => $doctorSelect.trigger('change'), 100);
                                preselectedDoctorId = null; // Sadece ilk yüklemede çalışsın
                            }
                        }
                    },
                    error: function () {
                        alert("Doktorlar yüklenirken hata oluştu.");
                    }
                });
            });

            $doctorSelect.change(function () {
                const doctorId = $(this).val();
                $datePicker.val("");
                resetTimeSelect();
                $datePicker.prop("disabled", !doctorId);
                doctorAvailability = null;
                renderAvailability(null);

                if (!doctorId) {
                    $scheduleNote.text("Doktor seçildiğinde uygun gün planı burada gösterilir.");
                    return;
                }

                loadDoctorAvailability(doctorId);
            });

            $datePicker.change(function () {
                if (!isSelectedDateAllowed()) {
                    resetTimeSelect();
                    loadRecommendations();
                    return;
                }

                loadSlots();
                loadRecommendations();
            });

            function loadDoctorAvailability(doctorId) {
                $scheduleNote.text("Doktor çalışma planı yükleniyor...");

                $.ajax({
                    url: "/Appointment/GetDoctorAvailability",
                    type: "GET",
                    data: { doctorId: doctorId },
                    success: function (availability) {
                        doctorAvailability = availability;
                        const summary = availability.summary || availability.Summary || "";
                        $scheduleNote.text("Çalışma planı: " + summary + ".");
                        renderAvailability(availability);
                        $msgBox.text("Doktor için uygun gün ve saat planı hazır.").removeClass("text-danger").addClass("text-success");
                        loadRecommendations();

                        if (preselectedDate) {
                            $datePicker.val(preselectedDate);
                            setTimeout(() => $datePicker.trigger('change'), 100);
                            preselectedDate = null;
                        }
                    },
                    error: function () {
                        doctorAvailability = null;
                        $scheduleNote.text("Doktor çalışma planı alınamadı.");
                        renderAvailability(null);
                        $msgBox.text("Doktor çalışma planı alınamadı.").removeClass("text-success").addClass("text-danger");
                    }
                });
            }

            function renderAvailability(availability) {
                $availabilityDays.empty();
                $availabilityHours.empty();

                if (!availability) {
                    $availabilityPreview.addClass("d-none");
                    return;
                }

                const workingDayNames = availability.workingDayNames || availability.WorkingDayNames || [];
                const availableHours = availability.availableHours || availability.AvailableHours || [];

                $.each(workingDayNames, function (_, dayName) {
                    $availabilityDays.append(`<span class="availability-chip day">${dayName}</span>`);
                });

                $.each(availableHours, function (_, hour) {
                    $availabilityHours.append(`<span class="availability-chip hour">${hour}</span>`);
                });

                $availabilityPreview.removeClass("d-none");
            }

            function isSelectedDateAllowed() {
                const dateVal = $datePicker.val();
                if (!dateVal || !doctorAvailability) {
                    return true;
                }

                const workingDays = doctorAvailability.workingDays || doctorAvailability.WorkingDays;
                if (!workingDays) return true;

                const selectedDate = new Date(dateVal + "T00:00:00");
                if (workingDays.includes(selectedDate.getDay())) {
                    return true;
                }

                const summary = doctorAvailability.summary || doctorAvailability.Summary || "";
                $msgBox.text("Seçtiğiniz gün bu doktorun çalışma planında yok. " + summary + " hizmet vermektedir.")
                    .removeClass("text-success")
                    .addClass("text-danger");
                return false;
            }

            function loadSlots() {
                const doctorId = $doctorSelect.val();
                const dateVal = $datePicker.val();
                if (!doctorId || !dateVal) {
                    resetTimeSelect();
                    return;
                }

                $msgBox.text("Müsaitlik durumu kontrol ediliyor...").removeClass("text-danger text-success");
                $timeSelect.empty().append("<option>Yükleniyor...</option>").prop("disabled", true);

                $.ajax({
                    url: "/Appointment/GetTakenSlots",
                    type: "GET",
                    data: { doctorId: doctorId, date: dateVal },
                    success: function (payload) {
                        $timeSelect.empty().append('<option value="">-- Saat seçiniz --</option>');
                        const isAvailableDay = payload.isAvailableDay ?? payload.IsAvailableDay;
                        const isHoliday = payload.isHoliday ?? payload.IsHoliday;
                        const message = payload.message ?? payload.Message ?? "";
                        const availableHours = payload.availableHours ?? payload.AvailableHours ?? [];
                        const takenSlots = payload.takenSlots ?? payload.TakenSlots ?? [];

                        if (!isAvailableDay) {
                            if (isHoliday) {
                                $msgBox.text("Bugün resmi tatil.").removeClass("text-success").addClass("text-danger");
                            } else {
                                $msgBox.text(message).removeClass("text-success").addClass("text-danger");
                            }
                            return;
                        }

                        let hasSlot = false;
                        $.each(availableHours, function (_, hourString) {
                            if (takenSlots.includes(hourString)) {
                                $timeSelect.append(`<option value="${hourString}" disabled>${hourString} (DOLU)</option>`);
                            } else {
                                $timeSelect.append(`<option value="${hourString}">${hourString}</option>`);
                                hasSlot = true;
                            }
                        });

                        if (!hasSlot) {
                            $msgBox.text("Bugün için boş yer kalmamıştır.").addClass("text-danger");
                        } else {
                            $msgBox.text(message).addClass("text-success");
                            $timeSelect.prop("disabled", false);

                            if (preselectedTime) {
                                $timeSelect.val(preselectedTime);
                                preselectedTime = null;
                            }
                        }
                    },
                    error: function () {
                        $msgBox.text("Müsaitlik bilgisi alınamadı.").addClass("text-danger");
                    }
                });
            }

            function resetTimeSelect() {
                $timeSelect.empty().append('<option value="">-- Önce tarih ve doktor seçin --</option>');
                $timeSelect.prop("disabled", true);
                $msgBox.text("").removeClass("text-danger text-success");
                $suggestions.addClass("d-none");
                $suggestionButtons.empty();
                $finalInput.val("");
            }

            function loadRecommendations() {
                const doctorId = $doctorSelect.val();
                const startDate = $datePicker.val();

                if (!doctorId) {
                    $suggestions.addClass("d-none");
                    $suggestionButtons.empty();
                    return;
                }

                $.ajax({
                    url: "/Appointment/GetRecommendedSlots",
                    type: "GET",
                    data: { doctorId: doctorId, startDate: startDate },
                    success: function (items) {
                        $suggestionButtons.empty();
                        if (!items || items.length === 0) {
                            $suggestions.addClass("d-none");
                            return;
                        }

                        $.each(items, function (_, slot) {
                            const val = slot.value || slot.Value;
                            const lbl = slot.label || slot.Label;
                            if (!val) return;

                            const [datePart, timePart] = val.split("T");
                            const $btn = $('<button type="button" class="btn btn-sm btn-outline-primary rounded-pill"></button>');
                            $btn.text(lbl);
                            $btn.on("click", function () {
                                $datePicker.val(datePart);
                                loadSlots();

                                const waitForSlots = setInterval(function () {
                                    if (!$timeSelect.prop("disabled")) {
                                        $timeSelect.val(timePart.substring(0, 5));
                                        clearInterval(waitForSlots);
                                    }
                                }, 120);
                            });

                            $suggestionButtons.append($btn);
                        });

                        $suggestions.removeClass("d-none");
                    }
                });
            }

            $("#appointmentForm").submit(function (e) {
                const d = $datePicker.val();
                const t = $timeSelect.val();
                if (!d || !t) {
                    e.preventDefault();
                    alert("Lütfen tarih ve saat seçiniz.");
                } else {
                    $finalInput.val(d + "T" + t);
                }
            });
        });
    </script>
}

