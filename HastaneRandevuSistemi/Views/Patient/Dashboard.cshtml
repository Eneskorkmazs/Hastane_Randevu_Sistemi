@model HastaneRandevuSistemi.ViewModels.PatientDashboardViewModel

@{
    ViewData["Title"] = "Hasta Paneli";
    var nextAppointment = Model.PendingAppointments.OrderBy(a => a.AppointmentDate).FirstOrDefault();
}

@section Scripts {
    <script>
        document.getElementById('btnCheckSymptom').addEventListener('click', function() {
            const input = document.getElementById('symptomInput');
            const text = input.value.trim();
            if (!text) return;

            const list = document.getElementById('symptomList');
            const results = document.getElementById('symptomResults');
            const loading = document.getElementById('symptomLoading');
            const placeholder = document.getElementById('symptomPlaceholder');

            placeholder.style.display = 'none';
            results.style.display = 'none';
            loading.style.display = 'block';

            fetch('@Url.Action("CheckSymptoms", "Patient")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ text: text })
            })
            .then(response => response.json())
            .then(data => {
                loading.style.display = 'none';
                list.innerHTML = '';
                
                if (data.isChat) {
                    // Chat response
                    const div = document.createElement('div');
                    div.className = 'p-3 rounded-4 bg-primary-soft text-primary border border-primary border-opacity-10 mb-2 small';
                    div.innerHTML = `<i class="fa-solid fa-comment-dots me-2"></i><strong>ENS:</strong> ${data.message}`;
                    list.appendChild(div);
                    results.style.display = 'block';
                } else if (data.suggestions && data.suggestions.length > 0) {
                    // Suggestions response
                    data.suggestions.forEach(item => {
                        const div = document.createElement('div');
                        div.className = 'symptom-item p-3 rounded-4 bg-white border border-light-subtle d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 transition-all hover-shadow mb-2';
                        div.innerHTML = `
                            <div class="d-flex align-items-center gap-3 flex-grow-1 overflow-hidden">
                                <div class="icon-box bg-primary-soft text-primary rounded-4" style="width: 45px; height: 45px; min-width: 45px;">
                                    <i class="fa-solid ${item.icon || 'fa-user-doctor'}"></i>
                                </div>
                                <div class="overflow-hidden">
                                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">${item.departmentName}</div>
                                    <div class="x-small text-muted text-truncate">${item.reasoning}</div>
                                </div>
                            </div>
                            <div class="d-flex flex-row flex-sm-column align-items-center align-items-sm-end gap-2 flex-shrink-0">
                                <span class="badge bg-success-soft text-success border border-success border-opacity-10 rounded-pill px-2 py-1" style="font-size: 0.65rem;">%${item.confidenceScore} Uygun</span>
                                <a href="/Appointment/Create?deptId=${item.departmentId}" class="btn btn-primary btn-sm rounded-pill px-3 py-1 fw-bold shadow-sm" style="font-size: 0.75rem;">Randevu Al</a>
                            </div>
                        `;
                        list.appendChild(div);
                    });
                    results.style.display = 'block';
                } else {
                    list.innerHTML = '<p class="text-center x-small text-muted p-3">Anlayamadım, lütfen daha detaylı belirtir misiniz?</p>';
                    results.style.display = 'block';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                loading.style.display = 'none';
                placeholder.style.display = 'block';
                list.innerHTML = '<div class="alert alert-danger x-small py-2"><i class="fa-solid fa-triangle-exclamation me-2"></i>Analiz sırasında bir hata oluştu. Lütfen tekrar deneyin.</div>';
                results.style.display = 'block';
            });
        });

        document.getElementById('symptomInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                document.getElementById('btnCheckSymptom').click();
            }
        });

        // Notification Management (Dashboard)
        const headerBadge = document.getElementById("unreadNotificationBadge");

        async function postAjax(url, id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const params = new URLSearchParams();
            params.append('id', id);

            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'RequestVerificationToken': token || ''
                },
                body: params.toString(),
                credentials: 'same-origin'
            });

            if (!response.ok) return null;
            try { return await response.json(); } catch { return null; }
        }

        document.querySelectorAll('.mark-read-dash-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.stopPropagation();
                const id = btn.dataset.id;
                const result = await postAjax('@Url.Action("MarkAsReadAjax", "Patient")', id);
                if (result && result.success) {
                    const item = btn.closest('.notification-item-dashboard');
                    item.classList.add('opacity-75');
                    item.classList.remove('bg-primary-soft', 'border-start', 'border-3', 'border-primary');
                    btn.remove();
                    if (headerBadge) {
                        const count = Number(result.unreadCount ?? 0);
                        headerBadge.textContent = String(count);
                        headerBadge.style.display = count > 0 ? "inline-flex" : "none";
                    }
                }
            });
        });

        document.querySelectorAll('.delete-notif-dash-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.stopPropagation();
                if (!confirm('Silmek istediğinize emin misiniz?')) return;
                const id = btn.dataset.id;
                const result = await postAjax('@Url.Action("DeleteNotificationAjax", "Patient")', id);
                if (result && result.success) {
                    const item = btn.closest('.notification-item-dashboard');
                    item.style.transition = 'all 0.3s ease';
                    item.style.opacity = '0';
                    item.style.transform = 'translateX(20px)';
                    setTimeout(() => item.remove(), 300);
                }
            });
        });
    </script>
}

<div class="container-fluid px-md-4 py-4">
    <!-- Hero Section -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden mb-4 hero-card" style="background: linear-gradient(135deg, #0d6efd 0%, #052c65 100%);">
        <div class="card-body p-3 p-md-4 position-relative">
            <div class="row align-items-center g-3">
                <div class="col-lg-8 position-relative z-1">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-white bg-opacity-10 text-white rounded-pill px-2 py-1 fw-normal small" style="backdrop-filter: blur(5px); border: 1px solid rgba(255,255,255,0.1);">
                            <i class="fa-solid fa-sparkles me-1 text-warning x-small"></i> Sağlıklı Günler
                        </span>
                    </div>
                    <h2 class="fw-bold text-white mb-2">Merhaba, <span class="text-info">@Model.FullName</span></h2>
                    <p class="text-white opacity-75 mb-3 small">Sağlık durumunuzu ve randevularınızı buradan yönetebilirsiniz.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Appointment" asp-action="Create" class="btn btn-light btn-sm rounded-pill px-3 py-1 fw-bold text-primary shadow-sm hover-up">
                            <i class="fa-solid fa-calendar-plus me-1"></i>Yeni Randevu
                        </a>
                        <a asp-controller="Patient" asp-action="MedicalHistory" class="btn btn-outline-light btn-sm rounded-pill px-3 py-1 fw-bold bg-white bg-opacity-10 border-white border-opacity-25 hover-up" style="backdrop-filter: blur(5px);">
                            <i class="fa-solid fa-file-medical me-1"></i>Sağlık Geçmişim
                        </a>
                    </div>
                </div>
            </div>
            <!-- Decorative Elements -->
            <div class="position-absolute top-50 end-0 translate-middle-y p-4 opacity-10 d-none d-lg-block">
                <i class="fa-solid fa-heart-pulse" style="font-size: 8rem; color: white;"></i>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Column (Left) -->
        <div class="col-lg-8">
            
            <!-- Smart Alert / Next Appointment -->
            @if (nextAppointment != null)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-white overflow-hidden">
                    <div class="card-body p-4 position-relative">
                        <div class="row align-items-center position-relative z-1">
                            <div class="col-auto">
                                <div class="date-badge text-center bg-white text-primary rounded-4 p-3 shadow-sm" style="min-width: 85px;">
                                    <div class="h3 fw-bold mb-0">@nextAppointment.AppointmentDate.Day</div>
                                    <div class="small text-uppercase fw-bold">@nextAppointment.AppointmentDate.ToString("MMM")</div>
                                </div>
                            </div>
                            <div class="col">
                                <h5 class="fw-bold mb-1">Sıradaki Randevunuz</h5>
                                <div class="h4 fw-bold mb-2">Dr. @nextAppointment.Doctor?.Name @nextAppointment.Doctor?.Surname</div>
                                <div class="d-flex flex-wrap gap-3 small opacity-75">
                                    <span><i class="fa-solid fa-clock me-1"></i> @nextAppointment.AppointmentDate.ToString("HH:mm")</span>
                                    <span><i class="fa-solid fa-hospital me-1"></i> @nextAppointment.Doctor?.Department?.Name</span>
                                </div>
                            </div>
                            <div class="col-auto position-relative z-2">
                                <a asp-controller="Appointment" asp-action="Details" asp-route-id="@nextAppointment.Id" class="btn btn-light rounded-pill px-4 text-primary fw-bold shadow-sm">Detaylar</a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Quick Stats -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <a href="/Appointment/Index?status=0" class="text-decoration-none">
                        <div class="stat-card p-3 rounded-4 bg-white shadow-sm border-0 h-100" style="cursor:pointer;transition:transform .15s,box-shadow .15s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 20px rgba(0,0,0,.12)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
                            <div class="d-flex align-items-center gap-2">
                                <div class="icon-box bg-warning-soft text-warning rounded-3 flex-shrink-0"><i class="fa-solid fa-clock"></i></div>
                                <div class="overflow-hidden">
                                    <div class="x-small text-muted text-truncate">Bekleyen</div>
                                    <div class="h5 fw-bold mb-0">@Model.PendingAppointmentsCount</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/Appointment/Index?status=3" class="text-decoration-none">
                        <div class="stat-card p-3 rounded-4 bg-white shadow-sm border-0 h-100" style="cursor:pointer;transition:transform .15s,box-shadow .15s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 20px rgba(0,0,0,.12)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
                            <div class="d-flex align-items-center gap-2">
                                <div class="icon-box bg-success-soft text-success rounded-3 flex-shrink-0"><i class="fa-solid fa-check-double"></i></div>
                                <div class="overflow-hidden">
                                    <div class="x-small text-muted text-truncate">Tamamlanan</div>
                                    <div class="h5 fw-bold mb-0">@Model.CompletedAppointmentsCount</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/Patient/Prescriptions" class="text-decoration-none">
                        <div class="stat-card p-3 rounded-4 bg-white shadow-sm border-0 h-100" style="cursor:pointer;transition:transform .15s,box-shadow .15s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 20px rgba(0,0,0,.12)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
                            <div class="d-flex align-items-center gap-2">
                                <div class="icon-box bg-info-soft text-info rounded-3 flex-shrink-0"><i class="fa-solid fa-file-prescription"></i></div>
                                <div class="overflow-hidden">
                                    <div class="x-small text-muted text-truncate">Reçete</div>
                                    <div class="h5 fw-bold mb-0">@Model.PrescriptionCount</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/Patient/Notifications" class="text-decoration-none">
                        <div class="stat-card p-3 rounded-4 bg-white shadow-sm border-0 h-100" style="cursor:pointer;transition:transform .15s,box-shadow .15s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 20px rgba(0,0,0,.12)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
                            <div class="d-flex align-items-center gap-2">
                                <div class="icon-box bg-primary-soft text-primary rounded-3 flex-shrink-0"><i class="fa-solid fa-bell"></i></div>
                                <div class="overflow-hidden">
                                    <div class="x-small text-muted text-truncate">Bildirim</div>
                                    <div class="h5 fw-bold mb-0">@Model.UnreadNotificationsCount</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Health History / Symptom Guide (New Section) -->

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden" style="min-height:380px;">
                        <div class="card-header border-0 px-4 py-3" style="background: linear-gradient(135deg,#1a73e8,#0d47a1);">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                        <i class="fa-solid fa-robot text-primary"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-white" style="font-size:0.95rem;">Akıllı Asistan ENS</div>
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="rounded-circle bg-success d-inline-block" style="width:7px;height:7px;"></span>
                                            <span class="text-white-50" style="font-size:0.7rem;">Çevrimiçi</span>
                                        </div>
                                    </div>
                                </div>
                                <a asp-controller="Symptom" asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-3" style="font-size:0.75rem;">
                                    Tam Ekran <i class="fa-solid fa-expand ms-1"></i>
                                </a>
                            </div>
                        </div>

                        <div class="card-body p-0 d-flex flex-column" style="height:290px;">
                            <div id="ensChatBox" class="flex-grow-1 overflow-auto p-3 d-flex flex-column gap-2" style="background:#f8fafc;">
                                <div class="d-flex align-items-end gap-2">
                                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:26px;height:26px;">
                                        <i class="fa-solid fa-robot text-white" style="font-size:11px;"></i>
                                    </div>
                                    <div style="background:white;border:1px solid #e2e8f0;border-radius:1rem;border-bottom-left-radius:3px;padding:10px 14px;font-size:13px;max-width:85%;">
                                        Merhaba! Şikayetinizi yazın veya seçin, size en uygun bölümü önereyim 👇
                                        <div class="d-flex flex-wrap gap-1 mt-2">
                                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 ens-quick" style="font-size:11px;" onclick="ensSend('Başım ağrıyor')">Baş ağrısı</button>
                                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 ens-quick" style="font-size:11px;" onclick="ensSend('Ateşim var')">Ateş</button>
                                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 ens-quick" style="font-size:11px;" onclick="ensSend('Karnım ağrıyor')">Karın ağrısı</button>
                                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 ens-quick" style="font-size:11px;" onclick="ensSend('Boğazım ağrıyor')">Boğaz</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="border-top p-2 bg-white">
                                <div class="d-flex gap-2">
                                    <input type="text" id="ensInput" class="form-control rounded-pill border-0 bg-light px-3" style="font-size:13px;" placeholder="Şikayetinizi yazın...">
                                    <button class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;" onclick="ensSendInput()">
                                        <i class="fa-solid fa-paper-plane" style="font-size:12px;"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <style>
                        #ensChatBox { scrollbar-width: thin; }
                    </style>
                    <script>
                        let ensHistory = [];
                        let ensFinished = false;

                        document.getElementById('ensInput').addEventListener('keydown', function(e) {
                            if (e.key === 'Enter') ensSendInput();
                        });

                        function ensSendInput() {
                            const val = document.getElementById('ensInput').value.trim();
                            if (val) ensSend(val);
                        }

                        window.ensSend = async function(msg) {
                            if (ensFinished) return;
                            document.querySelectorAll('.ens-quick').forEach(b => b.style.display='none');
                            const box = document.getElementById('ensChatBox');
                            document.getElementById('ensInput').value = '';

                            box.insertAdjacentHTML('beforeend', `
                                <div class="d-flex justify-content-end">
                                    <div style="background:#1a73e8;color:white;border-radius:1rem;border-bottom-right-radius:3px;padding:8px 13px;font-size:13px;max-width:80%;">${msg}</div>
                                </div>`);

                            box.insertAdjacentHTML('beforeend', `
                                <div id="ensTyping" class="d-flex align-items-end gap-2">
                                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:26px;height:26px;">
                                        <i class="fa-solid fa-robot text-white" style="font-size:11px;"></i>
                                    </div>
                                    <div style="background:white;border:1px solid #e2e8f0;border-radius:1rem;border-bottom-left-radius:3px;padding:8px 14px;">
                                        <span class="d-inline-flex gap-1">
                                            <span class="rounded-circle bg-secondary d-inline-block" style="width:5px;height:5px;animation:bounce 1.2s infinite;"></span>
                                            <span class="rounded-circle bg-secondary d-inline-block" style="width:5px;height:5px;animation:bounce 1.2s infinite 0.2s;"></span>
                                            <span class="rounded-circle bg-secondary d-inline-block" style="width:5px;height:5px;animation:bounce 1.2s infinite 0.4s;"></span>
                                        </span>
                                    </div>
                                </div>`);
                            box.scrollTop = box.scrollHeight;

                            try {
                                ensHistory.push(msg);
                                const res = await fetch('@Url.Action("Chat","Symptom")', {
                                    method: 'POST',
                                    headers: {'Content-Type':'application/json'},
                                    body: JSON.stringify({message: msg, history: ensHistory})
                                });
                                const data = await res.json();
                                document.getElementById('ensTyping')?.remove();

                                let html = `<div style="background:white;border:1px solid #e2e8f0;border-radius:1rem;border-bottom-left-radius:3px;padding:10px 14px;font-size:13px;max-width:85%;">${data.message}`;

                                if (data.quickReplies && data.quickReplies.length) {
                                    html += `<div class="d-flex flex-wrap gap-1 mt-2">`;
                                    data.quickReplies.forEach(qr => {
                                        html += `<button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 ens-quick" style="font-size:11px;" onclick="ensSend('${qr}')">${qr}</button>`;
                                    });
                                    html += `</div>`;
                                }

                                if (data.suggestions && data.suggestions.length) {
                                    data.suggestions.forEach(s => {
                                        html += `<div class="d-flex justify-content-between align-items-center mt-2 p-2 rounded-3 border" style="background:#f1f5f9;">
                                            <span class="fw-semibold" style="font-size:12px;">${s.departmentName}</span>
                                            <a href="/Appointment/Create?departmentId=${s.departmentId}" class="btn btn-primary btn-sm rounded-pill px-2 py-0" style="font-size:11px;">Randevu Al</a>
                                        </div>`;
                                    });
                                    ensFinished = true;
                                }

                                html += `</div>`;

                                box.insertAdjacentHTML('beforeend', `
                                    <div class="d-flex align-items-end gap-2">
                                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:26px;height:26px;">
                                            <i class="fa-solid fa-robot text-white" style="font-size:11px;"></i>
                                        </div>
                                        ${html}
                                    </div>`);
                                box.scrollTop = box.scrollHeight;
                            } catch(e) {
                                document.getElementById('ensTyping')?.remove();
                            }
                        };
                    </script>

                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-light-soft">
                        <div class="card-body p-4 text-center">
                            <div class="mb-3 text-primary display-6"><i class="fa-solid fa-shield-heart"></i></div>
                            <h5 class="fw-bold mb-2">Sağlık Karneniz</h5>
                            <p class="small text-muted mb-3">Tüm tıbbi verilerinizi, reçetelerinizi ve analizlerinizi tek bir rapor halinde görün.</p>
                            <a asp-action="MedicalHistory" class="btn btn-primary rounded-pill px-4 fw-bold">Geçmişi İncele</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hastane Değerlendirmem Section -->
            <div class="row g-4 mt-1">
                <div class="col-12">
                    @if (Model.UserHospitalReview != null)
                    {
                        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden bg-white">
                            <div class="card-header bg-white p-4 border-bottom border-light d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-warning-soft text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        <i class="fa-solid fa-star"></i>
                                    </div>
                                    <h6 class="fw-bold mb-0">Hastane Değerlendirmem</h6>
                                </div>
                                <span class="badge bg-success-soft text-success border border-success border-opacity-10 rounded-pill px-3 py-1 small">
                                    Yayında
                                </span>
                            </div>
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="rating-stars">
                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            <i class="fa-solid fa-star @(i <= Model.UserHospitalReview.Rating ? "text-warning" : "text-secondary opacity-25")" style="font-size: 1.1rem;"></i>
                                        }
                                        <span class="fw-bold ms-2 text-dark">(@Model.UserHospitalReview.Rating / 5)</span>
                                    </div>
                                    <small class="text-muted">@Model.UserHospitalReview.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.UserHospitalReview.Comment))
                                {
                                    <p class="text-muted small mb-3 p-3 bg-light rounded-4 border-start border-3 border-warning">
                                        "@Model.UserHospitalReview.Comment"
                                    </p>
                                }
                                else
                                {
                                    <p class="text-muted small mb-3 italic">Yorum metni bırakılmadı, sadece puan verildi.</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.UserHospitalReview.AdminReply))
                                {
                                    <div class="mt-3 p-3 bg-primary-soft rounded-4 border-start border-4 border-primary">
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fa-solid fa-hospital text-primary me-2"></i>
                                            <strong class="text-dark small">Hastane Yönetimi Yanıtı</strong>
                                            @if (Model.UserHospitalReview.AdminReplyDate.HasValue)
                                            {
                                                <span class="text-muted x-small ms-auto">@Model.UserHospitalReview.AdminReplyDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                            }
                                        </div>
                                        <p class="mb-0 small text-muted">@Model.UserHospitalReview.AdminReply</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted x-small italic mt-2">
                                        <i class="fa-solid fa-clock me-1"></i> Hastane yönetimi henüz yanıt bırakmadı.
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary-soft border border-primary border-opacity-10 overflow-hidden">
                            <div class="card-body p-4 text-center">
                                <div class="mb-3 text-primary display-6"><i class="fa-solid fa-comment-medical"></i></div>
                                <h5 class="fw-bold mb-2">Hastane Değerlendirmesi Bırakın</h5>
                                <p class="small text-muted mb-3">Hizmet kalitemizi geliştirmek ve diğer hastalara rehberlik etmek için hastanemizi değerlendirebilirsiniz.</p>
                                <a href="/#features" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                    <i class="fa-solid fa-star me-2"></i>Değerlendirme Yap
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar (Right) -->
        <div class="col-lg-4">
            <!-- Emergency Health Card (New) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden bg-white">
                <div class="card-header bg-danger text-white py-3 px-4 border-0">
                    <h6 class="fw-bold mb-0"><i class="fa-solid fa-hospital-user me-2"></i>Kritik Sağlık Bilgileri</h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4 p-3 rounded-4 bg-danger-soft border border-danger border-opacity-10">
                        <div class="blood-type-circle bg-danger text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 50px; height: 50px; font-size: 1.2rem;">
                            @(Model.BloodType ?? "??")
                        </div>
                        <div>
                            <div class="x-small text-muted text-uppercase fw-bold">Kan Grubu</div>
                            <div class="fw-bold text-danger">@(Model.BloodType != null ? Model.BloodType : "Tanımlanmamış")</div>
                        </div>
                    </div>
                    <div class="health-meta mb-4">
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="x-small text-muted fw-bold">ALERJİLER</span>
                            <span class="small fw-bold text-dark text-end">@(Model.Allergies ?? "Yok")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="x-small text-muted fw-bold">KRONİK</span>
                            <span class="small fw-bold text-dark">Yok</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2">
                            <span class="x-small text-muted fw-bold">ACİL DURUM</span>
                            <span class="small fw-bold text-dark">@(Model.EmergencyContact ?? "-")</span>
                        </div>
                    </div>
                    <a asp-action="Profile" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                        <i class="fa-solid fa-user-pen me-2"></i>Bilgileri Güncelle
                    </a>
                </div>
            </div>

            <!-- Department Fees -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="fa-solid fa-turkish-lira-sign text-success me-2"></i>Bölüm Muayene Ücretleri</h6>
                    <div class="fee-list" style="max-height: 300px; overflow-y: auto; padding-right: 5px;">
                        @foreach (var fee in Model.DepartmentFees)
                        {
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-light">
                                <span class="small text-dark fw-semibold">@fee.DepartmentName</span>
                                <span class="small fw-bold text-success">@fee.Fee.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</span>
                            </div>
                        }
                    </div>
                    <div class="x-small text-muted mt-3 italic">
                        * Ücretler yaklaşık olup, SGK ve ek işlemlere göre değişiklik gösterebilir.
                    </div>
                </div>
            </div>

            <!-- Recent Notifications -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white p-4 border-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Son Bildirimler</h6>
                    <a asp-action="Notifications" class="x-small text-decoration-none">Tümü</a>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @if (Model.RecentNotifications == null || !Model.RecentNotifications.Any())
                        {
                            <div class="p-4 text-center text-muted x-small">Yeni bildirim bulunmuyor.</div>
                        }
                        else
                        {
                            foreach (var note in Model.RecentNotifications)
                            {
                                <div class="list-group-item p-3 @(note.IsRead ? "opacity-75" : "bg-primary-soft border-start border-3 border-primary") d-flex justify-content-between align-items-center notification-item-dashboard" data-id="@note.Id">
                                    <div class="flex-grow-1 me-2" onclick="if('@note.Link') window.location.href='@note.Link'" style="cursor: pointer;">
                                        <div class="d-flex justify-content-between mb-1">
                                            <div class="fw-bold small text-dark">@note.Title</div>
                                            <div class="x-small text-muted">@note.CreatedDate.ToString("dd MMM")</div>
                                        </div>
                                        <p class="x-small text-muted mb-0">@note.Message</p>
                                    </div>
                                    <div class="d-flex gap-1">
                                        @if (!note.IsRead)
                                        {
                                            <button type="button" class="btn btn-sm btn-light rounded-circle mark-read-dash-btn" data-id="@note.Id" title="Okundu işaretle">
                                                <i class="fa-solid fa-check text-success"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-light rounded-circle delete-notif-dash-btn" data-id="@note.Id" title="Sil">
                                            <i class="fa-solid fa-xmark text-danger"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Symptom Guide Modal -->
<div class="modal fade" id="symptomGuideModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-5">
            <div class="modal-header border-0 p-4">
                <h5 class="modal-title fw-bold">Branş Seçim Rehberi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 pt-0">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <h6 class="fw-bold text-primary mb-2">Dahiliye</h6>
                            <p class="x-small text-muted mb-0">Genel hastalıklar, şeker, tansiyon, karın ağrısı, vitamin eksiklikleri.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <h6 class="fw-bold text-primary mb-2">Ortopedi</h6>
                            <p class="x-small text-muted mb-0">Eklem ağrıları, kırıklar, burkulmalar, bel ve boyun fıtıkları.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <h6 class="fw-bold text-primary mb-2">KBB</h6>
                            <p class="x-small text-muted mb-0">Boğaz ağrısı, kulak çınlaması, burun tıkanıklığı, sinüzit.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <h6 class="fw-bold text-primary mb-2">Cildiye</h6>
                            <p class="x-small text-muted mb-0">Akne, saç dökülmesi, ben kontrolü, cilt lekeleri.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

