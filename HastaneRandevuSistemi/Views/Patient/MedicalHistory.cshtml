@model HastaneRandevuSistemi.ViewModels.PatientMedicalHistoryViewModel

@{
    ViewData["Title"] = "Saglik Gecmisim";
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <span class="text-uppercase small text-primary fw-bold">Hasta Modulu</span>
            <h1 class="h3 fw-bold mb-1">Saglik Gecmisim</h1>
            <p class="text-muted mb-0">Tibbi gecmis kayitlarinizi ve doktor recetelerinizi tek sayfada yonetin.</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-2"></i>Panele Don
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h2 class="h5 fw-bold mb-3">Yeni Kayit Ekle</h2>
            <form asp-action="AddMedicalHistory" method="post" enctype="multipart/form-data" class="row g-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-0"></div>

                <div class="col-md-6">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" maxlength="120" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="VisitDate" class="form-label fw-semibold"></label>
                    <input asp-for="VisitDate" type="date" class="form-control" />
                    <span asp-validation-for="VisitDate" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Ek Dosya (Opsiyonel)</label>
                    <input type="file" name="attachmentFile" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Diagnosis" class="form-label fw-semibold"></label>
                    <input asp-for="Diagnosis" class="form-control" maxlength="250" />
                    <span asp-validation-for="Diagnosis" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Medications" class="form-label fw-semibold"></label>
                    <input asp-for="Medications" class="form-control" maxlength="500" />
                    <span asp-validation-for="Medications" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AllergyInfo" class="form-label fw-semibold"></label>
                    <input asp-for="AllergyInfo" class="form-control" maxlength="500" />
                    <span asp-validation-for="AllergyInfo" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label fw-semibold"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="fa-solid fa-floppy-disk me-2"></i>Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 fw-bold mb-0">Kayit Gecmisi</h2>
                <span class="badge bg-light text-dark border rounded-pill">@Model.Records.Count kayit</span>
            </div>

            @if (!Model.Records.Any())
            {
                <div class="text-center py-5 text-muted bg-light rounded-4">
                    <i class="fa-solid fa-folder-open fa-2x mb-2"></i>
                    <p class="mb-0">Henuz tibbi gecmis kaydi bulunmuyor.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>Baslik</th>
                                <th>Tani</th>
                                <th>Ilaclar</th>
                                <th>Ek Dosya</th>
                                <th class="text-end">Islem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Records)
                            {
                                <tr>
                                    <td>@item.VisitDate.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <div class="fw-semibold">@item.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <div class="small text-muted mt-1">@item.Notes</div>
                                        }
                                    </td>
                                    <td class="text-muted">@(!string.IsNullOrWhiteSpace(item.Diagnosis) ? item.Diagnosis : "-")</td>
                                    <td class="text-muted">@(!string.IsNullOrWhiteSpace(item.Medications) ? item.Medications : "-")</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.AttachmentPath))
                                        {
                                            <a href="@item.AttachmentPath" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill">
                                                <i class="fa-solid fa-paperclip me-1"></i>@(item.AttachmentName ?? "Dosya")
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Yok</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="DeleteMedicalHistory" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kaydi silmek istiyor musunuz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                                <i class="fa-solid fa-trash-can me-1"></i>Sil
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div id="receteler" class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 fw-bold mb-0">Recetelerim</h2>
                <span class="badge bg-light text-dark border rounded-pill">@Model.PrescriptionCount recete</span>
            </div>

            @if (!Model.Prescriptions.Any())
            {
                <div class="text-center py-5 text-muted bg-light rounded-4">
                    <i class="fa-solid fa-prescription-bottle-medical fa-2x mb-2"></i>
                    <p class="mb-0">Henuz recete kaydi bulunmuyor.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Randevu Tarihi</th>
                                <th>Doktor / Brans</th>
                                <th>Tani</th>
                                <th>Ilaclar</th>
                                <th>Notlar</th>
                                <th>Recete Tarihi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Prescriptions)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</div>
                                        <a asp-controller="Appointment" asp-action="Details" asp-route-id="@item.AppointmentId" class="small text-decoration-none">Randevu detayi</a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.DoctorName</div>
                                        <div class="small text-muted">@item.DepartmentName</div>
                                    </td>
                                    <td>@item.Diagnosis</td>
                                    <td class="text-success-emphasis fw-semibold">@item.Medications</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes)</td>
                                    <td>@item.PrescriptionDate.ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
