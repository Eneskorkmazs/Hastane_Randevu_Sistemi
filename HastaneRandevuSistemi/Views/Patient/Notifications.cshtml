@model IEnumerable<HastaneRandevuSistemi.Models.Notification>

@{
    ViewData["Title"] = "Bildirimler";
    var totalCount = Model.Count();
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <span class="eyebrow text-primary">Bildirim Merkezi</span>
            <h1 class="h3 fw-bold mb-1">Hasta Bildirimleri</h1>
            <p class="text-muted mb-0">Randevu hareketleri ve profil güncellemeleri burada listelenir.</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge rounded-pill bg-light text-secondary border px-3 py-2">Toplam: @totalCount</span>
            <span id="notificationsUnreadBadge" class="badge rounded-pill bg-primary-subtle text-primary border border-primary px-3 py-2">Okunmamış: @unreadCount</span>

            <form id="markAllAsReadForm" asp-action="MarkAllAsReadAjax" method="post" class="notification-mark-all-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary rounded-pill px-4" @(unreadCount == 0 ? "disabled" : "")>
                    <i class="fa-solid fa-check-double me-2"></i>Tümünü Okundu İşaretle
                </button>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null || TempData["InfoMessage"] != null)
    {
        var alertClass = TempData["SuccessMessage"] != null ? "alert-success" :
                         TempData["ErrorMessage"] != null ? "alert-danger" : "alert-info";
        <div class="alert @alertClass shadow-sm rounded-3 d-flex justify-content-between align-items-center">
            <div>
                @TempData["SuccessMessage"]@TempData["ErrorMessage"]@TempData["InfoMessage"]
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5">
                <div class="empty-state">
                    <i class="fa-regular fa-bell-slash"></i>
                    <p class="mb-0">Henüz bildiriminiz bulunmuyor.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <form asp-action="DeleteSelected" method="post" id="deleteSelectedForm">
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="selectAllNotifications">
                    <label class="form-check-label" for="selectAllNotifications">Tümünü seç</label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-3" id="btnDeleteSelected" disabled>
                        <i class="fa-solid fa-trash-can me-2"></i>Seçilenleri Sil
                    </button>
                    <button type="submit" formaction="@Url.Action("DeleteAll")" class="btn btn-danger rounded-pill px-3" onclick="return confirm('Tüm bildirimler silinsin mi?');">
                        <i class="fa-solid fa-trash me-2"></i>Tümünü Sil
                    </button>
                </div>
            </div>

            <div class="notification-stack">
                @foreach (var item in Model)
                {
                    <div class="notification-card large @(item.IsRead ? "is-read" : "is-unread")">
                        <div class="d-flex justify-content-between gap-3 flex-wrap">
                            <div class="d-flex gap-2 align-items-start">
                                <input class="form-check-input mt-1 notification-checkbox" type="checkbox" name="ids" value="@item.Id" aria-label="Seç">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge rounded-pill bg-light text-dark border">@item.Type</span>
                                        @if (!item.IsRead)
                                        {
                                            <span class="badge rounded-pill bg-primary text-white">Yeni</span>
                                        }
                                        <strong>@item.Title</strong>
                                    </div>
                                    <p class="mb-2 text-muted">@item.Message</p>
                                    <div class="small text-muted">@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-2">
                                @if (!string.IsNullOrWhiteSpace(item.Link))
                                {
                                    <a href="@item.Link" class="btn btn-sm btn-light rounded-pill">İlgili Sayfa</a>
                                }
                                @if (!item.IsRead)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary rounded-pill mark-read-btn"
                                            data-id="@item.Id">
                                        <i class="fa-solid fa-check"></i>
                                    </button>
                                }
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger rounded-pill delete-notif-btn"
                                        data-id="@item.Id"
                                        title="Sil">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </form>
    }
</div>

    <form id="markReadForm" method="post" asp-action="MarkAsReadAjax" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="markReadId" />
    </form>

    <form id="deleteNotifForm" method="post" asp-action="DeleteNotificationAjax" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="deleteNotifId" />
    </form>

@section Scripts {
    <script>
        (function () {
            const cards = document.querySelectorAll(".notification-card");
            const summaryBadge = document.getElementById("notificationsUnreadBadge");
            const headerBadge = document.getElementById("unreadNotificationBadge");
            const markAllForm = document.getElementById("markAllAsReadForm");
            const markButtons = document.querySelectorAll(".mark-read-btn");
            const deleteButtons = document.querySelectorAll(".delete-notif-btn");
            const markReadForm = document.getElementById("markReadForm");
            const markReadIdInput = document.getElementById("markReadId");
            const deleteNotifForm = document.getElementById("deleteNotifForm");
            const deleteNotifIdInput = document.getElementById("deleteNotifId");

            function setUnreadCount(count) {
                if (!summaryBadge) {
                    return;
                }

                summaryBadge.textContent = 'Okunmamış: ' + count;
                const markAllButton = markAllForm?.querySelector("button");
                if (markAllButton) {
                    markAllButton.disabled = count === 0;
                }

                if (headerBadge) {
                    headerBadge.textContent = String(count);
                    headerBadge.style.display = count > 0 ? "inline-flex" : "none";
                }
            }

            async function postAjax(form) {
                const formData = new URLSearchParams(new FormData(form));
                const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'RequestVerificationToken': token || ''
                    },
                    body: formData.toString(),
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    return null;
                }

                try {
                    return await response.json();
                } catch {
                    return null;
                }
            }

            function hideMarkAsReadButton(card) {
                const markButton = card.querySelector('.mark-read-btn');
                if (markButton) {
                    markButton.remove();
                }
                const badge = card.querySelector('.badge.rounded-pill.bg-primary.text-white');
                if (badge) {
                    badge.remove();
                }
                card.classList.remove('is-unread');
                card.classList.add('is-read');
            }

            markButtons.forEach(button => {
                button.addEventListener('click', async (event) => {
                    event.preventDefault();
                    event.stopPropagation();

                    if (!markReadForm || !markReadIdInput) {
                        return;
                    }

                    markReadIdInput.value = button.dataset.id || '';
                    const result = await postAjax(markReadForm);

                    if (!result || result.success !== true) {
                        window.location.reload();
                        return;
                    }

                    setUnreadCount(Number(result.unreadCount ?? 0));
                    const card = button.closest('.notification-card');
                    if (card) {
                        hideMarkAsReadButton(card);
                    }
                });
            });

            deleteButtons.forEach(button => {
                button.addEventListener('click', async (event) => {
                    event.preventDefault();
                    event.stopPropagation();

                    if (!confirm('Bu bildirimi silmek istediğinize emin misiniz?')) return;

                    if (!deleteNotifForm || !deleteNotifIdInput) return;

                    deleteNotifIdInput.value = button.dataset.id || '';
                    const result = await postAjax(deleteNotifForm);

                    if (!result || result.success !== true) {
                        window.location.reload();
                        return;
                    }

                    const card = button.closest('.notification-card');
                    if (card) {
                        card.style.opacity = '0';
                        card.style.transform = 'translateX(20px)';
                        card.style.transition = 'all 0.3s ease';
                        setTimeout(() => {
                            card.remove();
                            if (document.querySelectorAll('.notification-card').length === 0) {
                                window.location.reload();
                            }
                        }, 300);
                    }
                });
            });

            if (markAllForm) {
                markAllForm.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const result = await postAjax(markAllForm);
                    if (!result || result.success !== true) {
                        window.location.reload();
                        return;
                    }

                    setUnreadCount(0);
                    cards.forEach(card => {
                        card.classList.remove('is-unread');
                        card.classList.add('is-read');
                        hideMarkAsReadButton(card);
                    });
                });
            }

            // Seçim ve silme
            const selectAll = document.getElementById("selectAllNotifications");
            const checkboxes = document.querySelectorAll(".notification-checkbox");
            const deleteSelectedBtn = document.getElementById("btnDeleteSelected");

            function updateDeleteButtonState() {
                const anyChecked = Array.from(checkboxes).some(cb => cb.checked);
                if (deleteSelectedBtn) {
                    deleteSelectedBtn.disabled = !anyChecked;
                }
            }

            if (selectAll) {
                selectAll.addEventListener("change", () => {
                    checkboxes.forEach(cb => cb.checked = selectAll.checked);
                    updateDeleteButtonState();
                });
            }

            checkboxes.forEach(cb => cb.addEventListener("change", () => {
                if (selectAll) {
                    const allChecked = Array.from(checkboxes).every(x => x.checked);
                    selectAll.checked = allChecked;
                    selectAll.indeterminate = !allChecked && Array.from(checkboxes).some(x => x.checked);
                }
                updateDeleteButtonState();
            }));
        })();
    </script>
}

<style>
    .eyebrow {
        display: inline-block;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .notification-stack {
        display: grid;
        gap: 1rem;
    }

    .notification-card {
        border-radius: 20px;
        padding: 1rem 1.1rem;
        background: #fff;
        border: 1px solid #edf1f5;
    }

    .notification-card.large {
        padding: 1.25rem 1.35rem;
    }

    .notification-card.is-unread {
        border-color: #b8ddff;
        background: linear-gradient(180deg, #f8fcff 0%, #eef7ff 100%);
    }

    .notification-card.is-read {
        opacity: 0.85;
    }

    .empty-state {
        min-height: 180px;
        display: grid;
        place-items: center;
        text-align: center;
        color: #7d8a97;
        gap: 0.75rem;
    }

    .empty-state i {
        font-size: 2.5rem;
    }
</style>
