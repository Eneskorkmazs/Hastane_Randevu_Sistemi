@section Scripts {
    <script>
        // Live Search & Filtering Functionality
        const searchInput = document.getElementById('helpSearchInput');
        const noResultsAlert = document.getElementById('noResultsAlert');
        const helpItems = document.querySelectorAll('.help-item');

        searchInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            let hasVisibleItems = false;

            if (!query) {
                helpItems.forEach(item => {
                    item.style.display = '';
                    item.classList.remove('highlight-card');
                });
                noResultsAlert.style.display = 'none';
                document.getElementById('faqTabs').style.display = '';
                return;
            }

            document.getElementById('faqTabs').style.display = 'none';
            const allTabBtn = document.getElementById('all-tab');
            if (allTabBtn) {
                const tab = new bootstrap.Tab(allTabBtn);
                tab.show();
            }

            helpItems.forEach(item => {
                const textContent = item.textContent.toLowerCase();
                const tags = (item.getAttribute('data-tags') || '').toLowerCase();

                if (textContent.includes(query) || tags.includes(query)) {
                    item.style.display = '';
                    item.classList.add('highlight-card');
                    hasVisibleItems = true;

                    const collapseElem = item.querySelector('.accordion-collapse');
                    if (collapseElem) {
                        const bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapseElem, { toggle: false });
                        bsCollapse.show();
                    }
                } else {
                    item.style.display = 'none';
                    item.classList.remove('highlight-card');
                }
            });

            noResultsAlert.style.display = hasVisibleItems ? 'none' : 'block';
        });

        function focusSearch() {
            searchInput.focus();
        }


        // Live Chat Simulation with Smart Bot Answers
        let liveChatModalInstance;
        function openLiveChatSim() {
            const modalEl = document.getElementById('liveSupportModal');
            liveChatModalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
            liveChatModalInstance.show();
            setTimeout(() => document.getElementById('liveSupportInput').focus(), 500);
        }

        function sendLiveChatMessage(e) {
            e.preventDefault();
            const input = document.getElementById('liveSupportInput');
            const msg = input.value.trim();
            if (!msg) return;

            const chatBox = document.getElementById('liveSupportChatBox');
            input.value = '';

            // User Message
            chatBox.insertAdjacentHTML('beforeend', `
                <div class="d-flex gap-2 mb-3 justify-content-end">
                    <div class="bg-success text-white p-3 rounded-4 shadow-sm border border-success small max-w-75">
                        ${msg}
                    </div>
                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px;">
                        <i class="fa-solid fa-user x-small"></i>
                    </div>
                </div>
            `);
            chatBox.scrollTop = chatBox.scrollHeight;

            // Typing Indicator
            const typingId = 'typingIndicator' + Date.now();
            chatBox.insertAdjacentHTML('beforeend', `
                <div id="${typingId}" class="d-flex gap-2 mb-3 align-items-center">
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px;">
                        <i class="fa-solid fa-headset x-small"></i>
                    </div>
                    <div class="bg-white p-3 rounded-4 shadow-sm border border-light small text-muted d-flex align-items-center gap-1">
                        <span class="rounded-circle bg-secondary d-inline-block" style="width: 6px; height: 6px; animation: bounce 1.2s infinite;"></span>
                        <span class="rounded-circle bg-secondary d-inline-block" style="width: 6px; height: 6px; animation: bounce 1.2s infinite 0.2s;"></span>
                        <span class="rounded-circle bg-secondary d-inline-block" style="width: 6px; height: 6px; animation: bounce 1.2s infinite 0.4s;"></span>
                    </div>
                </div>
            `);
            chatBox.scrollTop = chatBox.scrollHeight;

            // Advanced Smart Bot Logic
            setTimeout(() => {
                document.getElementById(typingId)?.remove();
                
                const lowerMsg = msg.toLowerCase();
                let reply = "Sorunuzu anladım. Konuyla ilgili en doğru ve hızlı yardımı alabilmek için lütfen **+90 543 870 96 57** numaralı çağrı merkezimizi arayın veya yandaki 'Hızlı Destek Talebi' formunu doldurun.";

                if (lowerMsg.includes("randevu") && (lowerMsg.includes("al") || lowerMsg.includes("nasıl"))) {
                    reply = "Randevu almak çok kolay! Üst menüdeki **'Randevu Al'** bağlantısına tıklayarak dilediğiniz bölüm ve doktordan saniyeler içinde randevu oluşturabilirsiniz.";
                } else if (lowerMsg.includes("randevu") && (lowerMsg.includes("iptal") || lowerMsg.includes("sil") || lowerMsg.includes("değiştir"))) {
                    reply = "Randevunuzu iptal etmek için üst menüden **'Randevularım'** sayfasına gidip ilgili randevunun yanındaki 'İptal Et' butonuna tıklamanız yeterlidir. (En geç 1 saat kala iptal edebilirsiniz).";
                } else if (lowerMsg.includes("ücret") || lowerMsg.includes("fiyat") || lowerMsg.includes("para") || lowerMsg.includes("muayene")) {
                    reply = "Hastanemizde SGK ve özel sağlık sigortaları geçerlidir. Özel muayene taban ücretlerimiz bölüm bazlı değişiklik göstermektedir (Ortalama 150 TL - 300 TL arası). Detayları panelinizdeki 'Bölüm Muayene Ücretleri' tablosundan inceleyebilirsiniz.";
                } else if (lowerMsg.includes("sgk") || lowerMsg.includes("sigorta") || lowerMsg.includes("bağkur") || lowerMsg.includes("emekli")) {
                    reply = "Evet, hastanemizin SGK (SSK, Bağ-Kur, Emekli Sandığı) ile tüm bölümlerde anlaşması bulunmaktadır. Yasal katılım payı haricinde ek bir muayene fark ücreti çıkmamaktadır.";
                } else if (lowerMsg.includes("tahlil") || lowerMsg.includes("sonuç") || lowerMsg.includes("röntgen") || lowerMsg.includes("kan")) {
                    reply = "Doktorunuzun muayene sırasında istediği tahlil, röntgen ve tetkik sonuçlarınızı **'Sağlık Geçmişim'** menüsünden görüntüleyebilir ve PDF olarak indirebilirsiniz.";
                } else if (lowerMsg.includes("reçete") || lowerMsg.includes("ilaç") || lowerMsg.includes("pdf")) {
                    reply = "Yazılan e-reçetelerinize **'Sağlık Geçmişim'** veya **'Reçeteler'** menüsünden ulaşabilirsiniz. Reçetenizin yanındaki 'PDF İndir' butonuna tıklayarak eczaneden ilaçlarınızı hemen alabilirsiniz.";
                } else if (lowerMsg.includes("eczane") || lowerMsg.includes("nöbetçi")) {
                    reply = "Acil ilaç ihtiyaçlarınız için üst menüdeki **'Eczaneler'** sayfasına tıklayarak konumunuza en yakın nöbetçi eczaneleri harita üzerinde anında görebilirsiniz.";
                } else if (lowerMsg.includes("şifre") || lowerMsg.includes("parola") || lowerMsg.includes("unuttum") || lowerMsg.includes("giriş")) {
                    reply = "Şifrenizi unuttuysanız giriş sayfasındaki 'Şifremi Unuttum' bağlantısına tıklayarak e-posta adresinize sıfırlama linki isteyebilirsiniz. Giriş yaptıktan sonra değiştirmek için Profilim > Şifre Değiştir menüsünü kullanabilirsiniz.";
                } else if (lowerMsg.includes("ens") || lowerMsg.includes("asistan") || lowerMsg.includes("yapay zeka") || lowerMsg.includes("robot")) {
                    reply = "Akıllı Asistan ENS, şikayetinize göre size en uygun hastane bölümünü öneren yapay zeka aracımızdır. Sayfadaki **'ENS'yi Dene'** butonuna tıklayarak hemen kullanmaya başlayabilirsiniz.";
                } else if (lowerMsg.includes("saat") || lowerMsg.includes("çalışma") || lowerMsg.includes("açılış") || lowerMsg.includes("mesai")) {
                    reply = "Hastanemiz ve Acil Servisimiz **7 gün 24 saat** kesintisiz hizmet vermektedir. Poliklinik muayenelerimiz ise hafta içi 08:30 - 17:30 saatleri arasında yapılmaktadır.";
                } else if (lowerMsg.includes("iletişim") || lowerMsg.includes("telefon") || lowerMsg.includes("adres") || lowerMsg.includes("nerede")) {
                    reply = "Hastanemiz Şanlıurfa merkezde yer almaktadır. Bize 7/24 **+90 543 870 96 57** numaralı telefondan veya info@havatakip.com.tr adresinden ulaşabilirsiniz.";
                } else if (lowerMsg.includes("selam") || lowerMsg.includes("merhaba") || lowerMsg.includes("naber") || lowerMsg.includes("iyi günler")) {
                    reply = "Merhaba! Size randevu alma, iptal işlemleri, muayene ücretleri, tahlil sonuçları veya nöbetçi eczaneler konusunda nasıl yardımcı olabilirim?";
                } else if (lowerMsg.includes("teşekkür") || lowerMsg.includes("sağol") || lowerMsg.includes("tşk")) {
                    reply = "Rica ederim, ne demek! Sağlıklı ve mutlu günler dileriz. Başka bir sorunuz olursa buradayım.";
                }

                chatBox.insertAdjacentHTML('beforeend', `
                    <div class="d-flex gap-2 mb-3">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px;">
                            <i class="fa-solid fa-headset x-small"></i>
                        </div>
                        <div class="bg-white p-3 rounded-4 shadow-sm border border-light small max-w-75 text-dark">
                            ${reply}
                        </div>
                    </div>
                `);
                chatBox.scrollTop = chatBox.scrollHeight;
            }, 1000);
        }
    </script>
}

