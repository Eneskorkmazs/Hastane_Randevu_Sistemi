@{
    ViewData["Title"] = "Yardım & Rehber";
}

<div class="container-fluid px-md-4 py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm p-4 mb-4 text-center" role="alert">
            <i class="fa-solid fa-circle-check fa-2x text-success mb-2"></i>
            <h5 class="fw-bold text-dark">İşlem Başarılı</h5>
            <p class="text-muted small mb-0">@TempData["SuccessMessage"]</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm p-4 mb-4 text-center" role="alert">
            <i class="fa-solid fa-triangle-exclamation fa-2x text-danger mb-2"></i>
            <h5 class="fw-bold text-dark">Hata Oluştu</h5>
            <p class="text-muted small mb-0">@TempData["ErrorMessage"]</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    <!-- Hero Section with Search -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden mb-5" style="background: linear-gradient(135deg, #0d6efd 0%, #052c65 100%);">
        <div class="card-body p-4 p-md-5 position-relative text-center">
            <div class="max-w-3xl mx-auto position-relative z-1">
                <span class="badge bg-white bg-opacity-10 text-white rounded-pill px-3 py-2 fw-normal mb-3 shadow-sm" style="backdrop-filter: blur(5px); border: 1px solid rgba(255,255,255,0.1);">
                    <i class="fa-solid fa-circle-question me-2 text-warning"></i> Hasta Yardım Merkezi & Kullanım Rehberi
                </span>
                <h1 class="fw-bold text-white mb-3 display-5">Size Nasıl Yardımcı Olabiliriz?</h1>
                <p class="text-white opacity-75 mb-4 lead fw-light">
                    Uygulamamızın nasıl çalıştığını öğrenin, sıkça sorulan sorulara göz atın veya aradığınız konuyu hızlıca bulun.
                </p>
                
                <!-- Live Search Box -->
                <div class="row justify-content-center">
                    <div class="col-md-9 col-lg-8">
                        <div class="input-group input-group-lg shadow-lg rounded-pill overflow-hidden bg-white p-1">
                            <span class="input-group-text bg-transparent border-0 text-primary ps-4">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input type="text" id="helpSearchInput" class="form-control border-0 shadow-none ps-2" placeholder="Randevu alma, muayene ücreti, şifre sıfırlama, eczane...">
                            <button class="btn btn-primary rounded-pill px-4 fw-bold m-1" type="button" onclick="focusSearch()">Ara</button>
                        </div>
                        <div class="text-white-50 x-small mt-2 text-center">
                            <span class="fw-semibold text-white">Popüler aramalar:</span> Randevu İptali, Akıllı Asistan ENS, Nöbetçi Eczane, SGK Geçerliliği
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- No Results Alert -->
    <div id="noResultsAlert" class="alert alert-warning rounded-4 shadow-sm p-4 text-center mb-5" style="display: none;">
        <i class="fa-solid fa-triangle-exclamation fa-2x text-warning mb-2"></i>
        <h5 class="fw-bold text-dark">Aramanızla Eşleşen Sonuç Bulunamadı</h5>
        <p class="text-muted small mb-0">Lütfen farklı anahtar kelimeler deneyin veya aşağıdaki iletişim kanallarından bize ulaşın.</p>
    </div>

    <!-- SECTION 1: Uygulama Nasıl Çalışır? (Hızlı Rehber Kartları) -->
    <div class="mb-5 help-section" id="guideSection">
        <div class="d-flex align-items-center gap-2 mb-4">
            <div class="bg-primary-soft text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                <i class="fa-solid fa-wand-magic-sparkles fa-lg"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">Uygulama Nasıl Çalışır?</h3>
                <p class="text-muted small mb-0">Sistemimizi en verimli şekilde kullanmanız için adım adım rehber</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Card 1: Randevu Alma -->
            <div class="col-md-6 col-lg-3 help-item" data-tags="randevu al yeni muayene doktor bölüm takvim tarih saat">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 guide-card transition-all hover-shadow bg-white position-relative overflow-hidden">
                    <div class="position-absolute top-0 end-0 p-3 opacity-10">
                        <i class="fa-solid fa-calendar-check fa-4x text-primary"></i>
                    </div>
                    <div class="icon-box bg-primary-soft text-primary rounded-4 mb-3" style="width: 55px; height: 55px; font-size: 1.5rem;">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </div>
                    <h5 class="fw-bold mb-2">1. Kolay Randevu Alma</h5>
                    <p class="text-muted small mb-3 flex-grow-1">
                        <strong>"Randevu Al"</strong> menüsünden istediğiniz bölümü ve uzman doktoru seçin. Size en uygun tarih ve saati belirleyerek saniyeler içinde randevunuzu oluşturun.
                    </p>
                    <div class="pt-2 border-top border-light mt-auto">
                        <a asp-controller="Appointment" asp-action="Create" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold w-100">
                            Randevu Al <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card 2: Akıllı Asistan ENS -->
            <div class="col-md-6 col-lg-3 help-item" data-tags="ens yapay zeka ai akıllı asistan semptom şikayet hastalık branş öneri robot">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 guide-card transition-all hover-shadow bg-white position-relative overflow-hidden">
                    <div class="position-absolute top-0 end-0 p-3 opacity-10">
                        <i class="fa-solid fa-robot fa-4x text-success"></i>
                    </div>
                    <div class="icon-box bg-success-soft text-success rounded-4 mb-3" style="width: 55px; height: 55px; font-size: 1.5rem;">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <h5 class="fw-bold mb-2">2. Akıllı Asistan ENS</h5>
                    <p class="text-muted small mb-3 flex-grow-1">
                        Hangi bölüme gitmeniz gerektiğinden emin değil misiniz? <strong>Akıllı Asistan ENS</strong>'ye şikayetinizi yazın, yapay zeka size en uygun branşı anında önersin.
                    </p>
                    <div class="pt-2 border-top border-light mt-auto">
                        <a asp-controller="Symptom" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold w-100">
                            ENS'yi Dene <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card 3: Nöbetçi Eczaneler -->
            <div class="col-md-6 col-lg-3 help-item" data-tags="eczane nöbetçi ilaç konum harita gps il ilçe arama bulma">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 guide-card transition-all hover-shadow bg-white position-relative overflow-hidden">
                    <div class="position-absolute top-0 end-0 p-3 opacity-10">
                        <i class="fa-solid fa-staff-snake fa-4x text-warning"></i>
                    </div>
                    <div class="icon-box bg-warning-soft text-warning rounded-4 mb-3" style="width: 55px; height: 55px; font-size: 1.5rem;">
                        <i class="fa-solid fa-staff-snake"></i>
                    </div>
                    <h5 class="fw-bold mb-2">3. Nöbetçi Eczaneler</h5>
                    <p class="text-muted small mb-3 flex-grow-1">
                        Acil ilaç ihtiyaçlarınız için <strong>"Eczaneler"</strong> sayfasına göz atın. Konumunuza en yakın veya seçtiğiniz il/ilçedeki nöbetçi eczaneleri harita üzerinde anında görün.
                    </p>
                    <div class="pt-2 border-top border-light mt-auto">
                        <a asp-controller="Patient" asp-action="Pharmacies" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold w-100">
                            Eczaneleri Gör <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card 4: Sağlık Geçmişi & Reçeteler -->
            <div class="col-md-6 col-lg-3 help-item" data-tags="sağlık geçmişi tıbbi kayıt reçete pdf tahlil tanı teşhis rapor inceleme">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 guide-card transition-all hover-shadow bg-white position-relative overflow-hidden">
                    <div class="position-absolute top-0 end-0 p-3 opacity-10">
                        <i class="fa-solid fa-file-medical fa-4x text-info"></i>
                    </div>
                    <div class="icon-box bg-info-soft text-info rounded-4 mb-3" style="width: 55px; height: 55px; font-size: 1.5rem;">
                        <i class="fa-solid fa-file-prescription"></i>
                    </div>
                    <h5 class="fw-bold mb-2">4. Sağlık Geçmişi & Reçeteler</h5>
                    <p class="text-muted small mb-3 flex-grow-1">
                        Geçmiş muayeneleriniz, doktor notları, konulan tanılar ve adınıza yazılan e-reçeteler tek tıkla elinizin altında. Reçetelerinizi PDF olarak indirebilirsiniz.
                    </p>
                    <div class="pt-2 border-top border-light mt-auto">
                        <a asp-controller="Patient" asp-action="MedicalHistory" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold w-100">
                            Geçmişimi İncele <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 2: Sıkça Sorulan Sorular (SSS) -->
    <div class="mb-5 help-section" id="faqSection">
        <div class="d-flex align-items-center gap-2 mb-4">
            <div class="bg-primary-soft text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                <i class="fa-solid fa-comments-question fa-lg"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">Sıkça Sorulan Sorular</h3>
                <p class="text-muted small mb-0">Aklınıza takılan tüm soruların detaylı yanıtları</p>
            </div>
        </div>

        <!-- FAQ Category Tabs -->
        <ul class="nav nav-pills mb-4 gap-2 faq-tabs" id="faqTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill px-4 fw-bold shadow-sm" id="all-tab" data-bs-toggle="pill" data-bs-target="#faq-all" type="button" role="tab">
                    <i class="fa-solid fa-layer-group me-1"></i> Tüm Sorular
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 fw-bold shadow-sm" id="randevu-tab" data-bs-toggle="pill" data-bs-target="#faq-randevu" type="button" role="tab">
                    <i class="fa-solid fa-calendar-days me-1"></i> Randevu İşlemleri
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 fw-bold shadow-sm" id="ucret-tab" data-bs-toggle="pill" data-bs-target="#faq-ucret" type="button" role="tab">
                    <i class="fa-solid fa-turkish-lira-sign me-1"></i> Ücretler & SGK
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 fw-bold shadow-sm" id="hesap-tab" data-bs-toggle="pill" data-bs-target="#faq-hesap" type="button" role="tab">
                    <i class="fa-solid fa-user-gear me-1"></i> Hesap & Teknik
                </button>
            </li>
        </ul>

        <!-- FAQ Tab Contents -->
        <div class="tab-content" id="faqTabContent">
            <!-- TAB 1: Tüm Sorular -->
            <div class="tab-pane fade show active" id="faq-all" role="tabpanel">
                <div class="accordion shadow-sm rounded-4 overflow-hidden" id="accordionAll">
                    
                    <!-- SSS 1 -->
                    <div class="accordion-item border-0 border-bottom help-item" data-tags="randevu iptal silme değiştirme saat tarih vazgeçme">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAll1">
                                <i class="fa-solid fa-circle-question text-primary me-2"></i> Randevumu nasıl iptal edebilirim veya değiştirebilirim?
                            </button>
                        </h2>
                        <div id="collapseAll1" class="accordion-collapse collapse show" data-bs-parent="#accordionAll">
                            <div class="accordion-body text-muted small bg-light-soft p-4">
                                Randevunuzu iptal etmek için üst menüden veya kullanıcı menüsünden <strong>"Randevularım"</strong> sayfasına gidin. İlgili randevunun yanındaki <strong>"İptal Et"</strong> butonuna tıklamanız yeterlidir. Randevu saatinize en geç 1 saat kala iptal işlemini gerçekleştirmeniz gerekmektedir. Değişiklik yapmak için mevcut randevunuzu iptal edip yeni bir randevu oluşturabilirsiniz.
                            </div>
                        </div>
                    </div>

                    <!-- SSS 2 -->
                    <div class="accordion-item border-0 border-bottom help-item" data-tags="muayene ücreti sgk sigorta para fiyat ödeme tahlil">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAll2">
                                <i class="fa-solid fa-circle-question text-primary me-2"></i> Muayene ücretleri ne kadar? SGK geçerli mi?
                            </button>
                        </h2>
                        <div id="collapseAll2" class="accordion-collapse collapse" data-bs-parent="#accordionAll">
                            <div class="accordion-body text-muted small bg-light-soft p-4">
                                Hastanemizde SGK (SSK, Bağ-Kur, Emekli Sandığı) ve anlaşmalı özel sağlık sigortaları geçerlidir. Panelinizdeki <strong>"Bölüm Muayene Ücretleri"</strong> tablosunda belirtilen tutarlar yaklaşık özel muayene taban ücretleridir. SGK güvenceniz varsa yasalarca belirlenen katılım payı uygulanır. Yapılacak ek tahlil, röntgen ve tetkikler ücrete tabidir.
                            </div>
                        </div>
                    </div>

                    <!-- SSS 3 -->
                    <div class="accordion-item border-0 border-bottom help-item" data-tags="aynı gün kaç randevu sınır limit kural">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAll3">
                                <i class="fa-solid fa-circle-question text-primary me-2"></i> Aynı gün içinde kaç farklı bölüme randevu alabilirim?
                            </button>
                        </h2>
                        <div id="collapseAll3" class="accordion-collapse collapse" data-bs-parent="#accordionAll">
                            <div class="accordion-body text-muted small bg-light-soft p-4">
                                Hastane kurallarımız ve yoğunluğun önlenmesi amacıyla bir hasta aynı gün içinde en fazla <strong>2 farklı bölüme</strong> randevu alabilir. Aynı bölüme ise günde yalnızca 1 kez randevu oluşturulabilir.
                            </div>
                        </div>
                    </div>

                    <!-- SSS 4 -->
                    <div class="accordion-item border-0 border-bottom help-item" data-tags="şifre unuttum sıfırlama değiştirme email eposta parola">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAll4">
                                <i class="fa-solid fa-circle-question text-primary me-2"></i> Şifremi unuttum veya değiştirmek istiyorum, ne yapmalıyım?
                            </button>
                        </h2>
                        <div id="collapseAll4" class="accordion-collapse collapse" data-bs-parent="#accordionAll">
                            <div class="accordion-body text-muted small bg-light-soft p-4">
                                Şifrenizi unuttuysanız giriş sayfasındaki <strong>"Şifremi Unuttum"</strong> bağlantısına tıklayarak e-posta adresinize sıfırlama linki gönderebilirsiniz. Sisteme giriş yaptıktan sonra şifrenizi değiştirmek isterseniz <strong>Profilim > Şifre Değiştir</strong> menüsünü kullanabilirsiniz.
                            </div>
                        </div>
                    </div>

                    <!-- SSS 5 -->
                    <div class="accordion-item border-0 border-bottom help-item" data-tags="reçete pdf indirme ilaç barkod e-reçete çıktı">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAll5">
                                <i class="fa-solid fa-circle-question text-primary me-2"></i> Reçetelerimi ve tahlil sonuçlarımı nasıl görebilirim?
                            </button>
                        </h2>
                        <div id="collapseAll5" class="accordion-collapse collapse" data-bs-parent="#accordionAll">
                            <div class="accordion-body text-muted small bg-light-soft p-4">
                                Doktorunuzun muayene sonrasında oluşturduğu reçetelere <strong>"Sağlık Geçmişim"</strong> veya <strong>"Reçeteler"</strong> sayfasından ulaşabilirsiniz. İlgili reçetenin yanındaki <strong>"PDF İndir"</strong> butonuna tıklayarak reçetenizi cihazınıza kaydedebilir veya eczaneye doğrudan bu belgeyi gösterebilirsiniz.
                            </div>
                        </div>
                    </div>

                    <!-- SSS 6 -->
                    <div class="accordion-item border-0 help-item" data-tags="ens akıllı asistan yapay zeka yanlış bölüm branş tavsiye">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAll6">
                                <i class="fa-solid fa-circle-question text-primary me-2"></i> Akıllı Asistan ENS'nin önerdiği bölüm dışında başka bir bölüme randevu alabilir miyim?
                            </button>
                        </h2>
                        <div id="collapseAll6" class="accordion-collapse collapse" data-bs-parent="#accordionAll">
                            <div class="accordion-body text-muted small bg-light-soft p-4">
                                Evet, kesinlikle. Akıllı Asistan ENS, şikayetlerinize göre size en uygun branşları önceliklendirerek rehberlik eder. Ancak nihai karar tamamen size aittir; dilediğiniz zaman <strong>"Randevu Al"</strong> menüsünden istediğiniz bölüm ve doktora randevu alabilirsiniz.
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- TAB 2: Randevu İşlemleri -->
            <div class="tab-pane fade" id="faq-randevu" role="tabpanel">
                <div class="accordion shadow-sm rounded-4 overflow-hidden" id="accordionRandevu">
                    <div class="accordion-item border-0 border-bottom help-item" data-tags="randevu iptal silme değiştirme saat tarih vazgeçme">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRandevu1">
                                <i class="fa-solid fa-calendar-check text-primary me-2"></i> Randevumu nasıl iptal edebilirim veya değiştirebilirim?
                            </button>
                        </h2>
                        <div id="collapseRandevu1" class="accordion-collapse collapse show" data-bs-parent="#accordionRandevu">
                            <div class="accordion-body text-muted small bg-light-soft p-4">
                                Randevunuzu iptal etmek için üst menüden veya kullanıcı menüsünden <strong>"Randevularım"</strong> sayfasına gidin. İlgili randevunun yanındaki <strong>"İptal Et"</strong> butonuna tıklamanız yeterlidir. Randevu saatinize en geç 1 saat kala iptal işlemini gerçekleştirmeniz gerekmektedir.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border-0 border-bottom help-item" data-tags="aynı gün kaç randevu sınır limit kural">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRandevu2">
                                <i class="fa-solid fa-calendar-check text-primary me-2"></i> Aynı gün içinde kaç farklı bölüme randevu alabilirim?
                            </button>
                        </h2>
                        <div id="collapseRandevu2" class="accordion-collapse collapse" data-bs-parent="#accordionRandevu">
                            <div class="accordion-body text-muted small bg-light-soft p-4">
                                Hastane kurallarımız ve yoğunluğun önlenmesi amacıyla bir hasta aynı gün içinde en fazla <strong>2 farklı bölüme</strong> randevu alabilir. Aynı bölüme ise günde yalnızca 1 kez randevu oluşturulabilir.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border-0 help-item" data-tags="hastanede bulunma saati erken gelme kayıt banko">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRandevu3">
                                <i class="fa-solid fa-calendar-check text-primary me-2"></i> Randevu saatimden ne kadar önce hastanede olmalıyım?
                            </button>
                        </h2>
                        <div id="collapseRandevu3" class="accordion-collapse collapse" data-bs-parent="#accordionRandevu">
                            <div class="accordion-body text-muted small bg-light-soft p-4">
                                Randevu saatinizden en az <strong>15 dakika önce</strong> hastanemizde olmanız ve hasta kabul bankolarından giriş işleminizi yaptırmanız tavsiye edilir.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: Ücretler & SGK -->
            <div class="tab-pane fade" id="faq-ucret" role="tabpanel">
                <div class="accordion shadow-sm rounded-4 overflow-hidden" id="accordionUcret">
                    <div class="accordion-item border-0 border-bottom help-item" data-tags="muayene ücreti sgk sigorta para fiyat ödeme tahlil">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-bold text-dark bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUcret1">
                                <i class="fa-solid fa-turkish-lira-sign text-primary me-2"></i> Muayene ücretleri ne kadar? SGK geçerli mi?
                            </button>
                        </h2>
                        <div id="collapseUcret1" class="accordion-collapse collapse show" data-bs-parent="#accordionUcret">
                            <div class="accordion-body text-muted small bg-light-soft p-4">
