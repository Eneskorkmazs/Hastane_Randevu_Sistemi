@using HastaneRandevuSistemi.Models
@{
    ViewData["Title"] = "Doktor Araçları";
    var recentAppointments = ViewBag.RecentAppointments as IReadOnlyList<Appointment> ?? Array.Empty<Appointment>();
    var doctorName = ViewBag.DoctorName as string ?? string.Empty;
    var departmentName = ViewBag.DepartmentName as string ?? string.Empty;
    var currentDoctorId = ViewBag.DoctorId as int? ?? 0;
}

<div class="container py-4">
    <div class="patient-hero mb-4">
        <div>
            <span class="eyebrow text-white-50">Doktor Paneli</span>
            <h1 class="mb-2">@doctorName</h1>
            <p class="mb-0">@departmentName bölümünde takvim, randevu ve reçete işlemlerini tek ekrandan yönetin.</p>
        </div>
        <div class="patient-hero-actions">
            <a asp-controller="Home" asp-action="DoctorDashboard" class="btn btn-light text-primary fw-bold rounded-pill px-4">
                <i class="fa-solid fa-chart-line me-2"></i>Panelim
            </a>
            <a asp-action="Schedule" class="btn btn-outline-light rounded-pill px-4">
                <i class="fa-solid fa-calendar-days me-2"></i>Takvimim
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-2">Çalışma Takvimi</h4>
                    <p class="text-muted">Müsait gün ve saatlerinizi görüntüleyin, hastaya uygun slotları yönetin.</p>
                    <a asp-action="Schedule" class="btn btn-primary rounded-pill">Takvimi Aç</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-2">Dijital Reçete</h4>
                    <p class="text-muted">Son randevulardan reçete oluşturun ve yazdırılabilir önizleme alın.</p>
                    <a asp-controller="Appointment" asp-action="Index" class="btn btn-outline-primary rounded-pill">Randevuları Gör</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-info-subtle">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-2 text-info-emphasis">Reçete Geçmişim</h4>
                    <p class="text-muted">Daha önce yazdığınız reçeteleri görüntüleyin ve kopyalayın.</p>
                    <a href="#previousPrescriptions" class="btn btn-info text-white rounded-pill">Geçmişe Git</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="h5 fw-bold mb-1">Son Randevularım</h3>
                    <p class="text-muted small mb-0">Size ait son randevuları takip edin.</p>
                </div>
            </div>

            @if (!recentAppointments.Any())
            {
                <div class="alert alert-light border mb-0">Henüz gösterilecek randevu bulunmuyor.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>Hasta</th>
                                <th>Doktor</th>
                                <th>Durum</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in recentAppointments)
                            {
                                <tr>
                                    <td>@item.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@item.PatientName @item.PatientSurname</td>
                                    <td>@item.Doctor?.Name @item.Doctor?.Surname</td>
                                    <td><span class="badge rounded-pill bg-light text-dark border">@item.Status</span></td>
                                    <td class="text-end">
                                        <a asp-controller="Appointment" asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info rounded-pill">
                                            <i class="fa-solid fa-notes-medical me-1"></i>Detay
                                        </a>
                                        @if (item.Status != AppointmentStatus.Iptal && item.PrescriptionCreatedAt == null && item.DoctorId == currentDoctorId)
                                        {
                                            if (item.Status == AppointmentStatus.Tamamlandi || item.AppointmentDate <= DateTime.Now)
                                            {
                                                <a asp-action="Prescription" asp-route-appointmentId="@item.Id"
                                                   class="btn btn-sm btn-primary rounded-pill ms-1">
                                                    <i class="fa-solid fa-file-prescription me-1"></i>Reçete Yaz
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="javascript:void(0);" onclick="showPrescriptionWarning('@item.Status')"
                                                   class="btn btn-sm btn-outline-secondary rounded-pill ms-1">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Reçete Yaz
                                                </a>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div id="previousPrescriptions" class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h3 class="h5 fw-bold mb-3">Yazdığım Son Reçeteler</h3>
            @{
                var myPrescriptions = ViewBag.MyPrescriptions as IReadOnlyList<Appointment> ?? Array.Empty<Appointment>();
            }
            @if (!myPrescriptions.Any())
            {
                <div class="alert alert-light border mb-0">Henüz yazdığınız bir reçete bulunmuyor.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>Hasta</th>
                                <th>Tanı</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in myPrescriptions)
                            {
                                <tr>
                                    <td>@item.PrescriptionCreatedAt?.ToString("dd.MM.yyyy")</td>
                                    <td>@item.PatientName @item.PatientSurname</td>
                                    <td><span class="text-truncate d-inline-block" style="max-width: 200px;">@item.PrescriptionDiagnosis</span></td>
                                    <td class="text-end">
                                        <a asp-action="DownloadPrescriptionPdf" asp-route-appointmentId="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                                            <i class="fa-solid fa-file-pdf me-1"></i>PDF
                                        </a>
                                        <a asp-action="Prescription" asp-route-appointmentId="@item.Id" class="btn btn-sm btn-light rounded-pill ms-1">
                                            <i class="fa-solid fa-eye me-1"></i>Gör
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function showPrescriptionWarning(status) {
        Swal.fire({
            title: 'Reçete Yazılamaz!',
            text: 'Bu randevu henüz "Tamamlandı" olarak işaretlenmediği ve saati gelmediği için reçete oluşturulamaz. Mevcut Durum: ' + status,
            icon: 'warning',
            confirmButtonText: 'Anladım',
            confirmButtonColor: '#004e92',
            background: '#fff',
            customClass: {
                popup: 'rounded-5 border-0 shadow-lg'
            }
        });
    }
</script>

