@model IEnumerable<HastaneRandevuSistemi.ViewModels.DoctorCalendarAppointmentViewModel>
@{
    var date = (DateTime)ViewBag.SelectedDate;
    ViewData["Title"] = $"{date:dd.MM.yyyy} Randevuları";
    bool isHoliday = ViewBag.IsHoliday ?? false;
    string? holidayLabel = ViewBag.HolidayLabel as string;
    bool isWorkingDay = ViewBag.IsWorkingDay ?? false;
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-controller="DoctorTools" asp-action="Schedule" class="btn btn-outline-secondary rounded-pill px-4"><i class="fa-solid fa-arrow-left me-2"></i>Takvime Dön</a>
    </div>

    @if (isHoliday)
    {
        <div class="alert alert-warning shadow-sm rounded-4 text-center p-4 mb-4">
            <h4 class="alert-heading fw-bold mb-2"><i class="fa-solid fa-holly-berry me-2"></i>Bugün Özel Bir Gün!</h4>
            <p class="mb-0 fs-5 text-dark">Bugün resmi tatil / özel gün: <strong>@holidayLabel</strong>. İyi tatiller dileriz!</p>
        </div>
    }
    else if (!isWorkingDay)
    {
        <div class="alert alert-secondary shadow-sm rounded-4 text-center p-4 mb-4">
            <h4 class="alert-heading fw-bold mb-2"><i class="fa-solid fa-mug-hot me-2"></i>Dinlenme Günü</h4>
            <p class="mb-0 fs-5">Bu gün için çalışma planlaması yapılmamıştır.</p>
        </div>
    }

    <div class="card border-0 shadow-lg rounded-5">
        <div class="card-header bg-primary text-white p-4 rounded-top-5">
            <h3 class="mb-0 fw-bold"><i class="fa-solid fa-calendar-day me-3"></i>@date.ToString("dd MMMM yyyy, dddd")</h3>
        </div>
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted bg-light rounded-4">
                    <i class="fa-regular fa-calendar-xmark fa-3x mb-3 text-secondary opacity-50"></i>
                    <h5>Bu tarih için planlanmış randevunuz bulunmuyor.</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Saat</th>
                                <th>Hasta</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@appointment.TimeLabel</td>
                                    <td>@appointment.PatientName</td>
                                    <td><span class="badge @appointment.StatusClass rounded-pill">@appointment.StatusText</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
