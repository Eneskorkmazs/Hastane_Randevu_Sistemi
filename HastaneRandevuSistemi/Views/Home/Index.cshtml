@model HastaneRandevuSistemi.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="full-width-hero position-relative overflow-hidden mb-5 shadow-lg"
     style="background: linear-gradient(135deg, #004e92 0%, #000428 100%); margin-top: -3rem;">

    <div class="position-absolute top-0 start-0 w-100 h-100 opacity-25"
         style="background-image: url('https://www.transparenttextures.com/patterns/cubes.png');"></div>

    <div class="container py-5 position-relative">
        <div class="row align-items-center text-center text-md-start py-5">
            <div class="col-lg-7 py-5">
                <span class="badge bg-info text-dark mb-3 px-3 py-2 rounded-pill fw-bold">7/24 Sağlık Hizmeti</span>
                <h1 class="display-3 fw-bold text-white mb-3 mt-2">Sağlığınız Bizim İçin <span class="text-info">Değerli</span></h1>
                <p class="fs-4 text-white mb-5 opacity-75">Uzman doktor kadromuz ve modern teknolojimizle hizmetinizdeyiz. Sıra beklemeden online randevunuzu saniyeler içinde oluşturun.</p>
                <div class="d-grid d-md-flex justify-content-md-start gap-3">
                    <a asp-controller="Appointment" asp-action="Create" class="btn btn-info btn-lg px-5 py-3 rounded-pill fw-bold shadow hover-grow text-dark">
                        <i class="fa-solid fa-calendar-check me-2"></i> Hemen Randevu Al
                    </a>
                    <a href="#features" class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill fw-bold hover-grow text-white">
                        Daha Fazla Bilgi
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <i class="fa-solid fa-house-medical-circle-check fa-10x text-white opacity-25"></i>
            </div>
        </div>
    </div>
</div>

<div id="features" class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-6">Neden HRS Hastanesi?</h2>
        <div class="mx-auto bg-primary rounded-pill" style="width: 80px; height: 5px;"></div>
    </div>

    <div class="row g-4 text-center">
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-shadow transition">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 100px; height: 100px;">
                    <i class="fa-solid fa-user-doctor fa-3x"></i>
                </div>
                <h3 class="fw-bold">Uzman Kadro</h3>
                <p class="text-muted">Alanında uzman profesör ve operatör doktorlarımızla en doğru teşhis ve tedavi süreçleri.</p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-shadow transition">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 100px; height: 100px;">
                    <i class="fa-solid fa-clock-rotate-left fa-3x"></i>
                </div>
                <h3 class="fw-bold">Hızlı Randevu</h3>
                <p class="text-muted">Gelişmiş otomasyon sistemimizle sıra beklemeden dilediğiniz doktordan anında randevu alın.</p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-shadow transition">
                <div class="rounded-circle bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 100px; height: 100px;">
                    <i class="fa-solid fa-laptop-medical fa-3x"></i>
                </div>
                <h3 class="fw-bold">Dijital Sağlık</h3>
                <p class="text-muted">Sonuçlarınızı online görüntüleyin, randevularınızı takip edin ve geçmişinizi tek tıkla inceleyin.</p>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5 mb-5">
    <div class="card border-0 shadow-lg rounded-5 overflow-hidden">
        <div class="row g-0 align-items-center">
            <div class="col-md-8 p-5">
                <h2 class="fw-bold display-6 mb-3">Bir sorunuz mu var?</h2>
                <p class="lead text-muted mb-4">Çağrı merkezimiz randevu ve bilgi desteği için haftanın her günü hattın diğer ucunda sizi bekliyor.</p>
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white rounded-circle p-3 me-3">
                        <i class="fa-solid fa-phone-volume fa-2x"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0">7/24 Çağrı Hattı</h6>
                        <h2 class="text-primary fw-bold mb-0">543 870 96 57</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4 bg-light p-5 text-center d-flex align-items-center justify-content-center border-start">
                <div class="text-center">
                    <i class="fa-solid fa-headset text-primary opacity-25 mb-3" style="font-size: 6rem;"></i>
                    <p class="fw-bold text-uppercase tracking-wider">Müşteri Hizmetleri</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <span class="eyebrow text-primary">Hasta Deneyimi</span>
                <h3 class="fw-bold mb-3">Genel Hastane Değerlendirmesi</h3>
                <p class="text-muted mb-4">Hizmet kalitemizi geliştirmek için puan ve yorum bırakabilirsiniz.</p>

                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="display-6 fw-bold text-primary">@Model.AverageRating.ToString("0.0")</div>
                    <div class="text-muted">/ 5 ortalama puan</div>
                </div>
                <div class="text-muted mb-3">@Model.TotalReviewCount değerlendirme</div>

                <form asp-action="SubmitHospitalReview" method="post" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-0" role="alert"></div>
                    @if (Model.HasCurrentUserReview)
                    {
                        <div class="alert alert-info small mb-0" role="alert">
                            Bu hesap ile daha önce değerlendirme yaptınız. Her hesap yalnızca bir yorum bırakabilir.
                        </div>
                    }

                    <div class="col-12">
                        <label asp-for="Rating" class="form-label fw-semibold">Puan</label>
                        <input asp-for="Rating" type="hidden" id="RatingInput" />
                        <div id="ratingStars" class="trendyol-stars" role="radiogroup" aria-label="Puan">
                            <button type="button" class="star-btn" data-value="1" aria-label="1 yıldız"><i class="fa-solid fa-star"></i></button>
                            <button type="button" class="star-btn" data-value="2" aria-label="2 yıldız"><i class="fa-solid fa-star"></i></button>
                            <button type="button" class="star-btn" data-value="3" aria-label="3 yıldız"><i class="fa-solid fa-star"></i></button>
                            <button type="button" class="star-btn" data-value="4" aria-label="4 yıldız"><i class="fa-solid fa-star"></i></button>
                            <button type="button" class="star-btn" data-value="5" aria-label="5 yıldız"><i class="fa-solid fa-star"></i></button>
                        </div>
                        <small id="ratingText" class="text-muted d-block mt-1">Puanınızı seçin</small>
                        <span asp-validation-for="Rating" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ReviewerName" class="form-label fw-semibold">Ad Soyad</label>
                        <input asp-for="ReviewerName" class="form-control" placeholder="Örnek: Ali Yılmaz" />
                        <span asp-validation-for="ReviewerName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Comment" class="form-label fw-semibold">Yorum (Opsiyonel)</label>
                        <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Deneyiminizi kısaca yazabilirsiniz"></textarea>
                        <span asp-validation-for="Comment" class="text-danger small"></span>
                    </div>

                    <div class="col-12 d-grid">
                        @if (Model.HasCurrentUserReview)
                        {
                            <button type="submit" class="btn btn-primary rounded-pill py-2 fw-semibold" disabled>
                                <i class="fa-solid fa-star me-2"></i>Değerlendirmeyi Gönder
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary rounded-pill py-2 fw-semibold">
                                <i class="fa-solid fa-star me-2"></i>Değerlendirmeyi Gönder
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h4 class="fw-bold mb-3">Son Değerlendirmeler</h4>

                @if (!Model.RecentReviews.Any())
                {
                    <div class="text-muted">Henüz değerlendirme bulunmuyor.</div>
                }
                else
                {
                    @for (var idx = 0; idx < Model.RecentReviews.Count; idx++)
                    {
                        var review = Model.RecentReviews[idx];
                        <article class="review-item py-3 @(idx < Model.RecentReviews.Count - 1 ? "border-bottom" : "")">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                <strong>@review.ReviewerName</strong>
                                <small class="text-muted">@review.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                            </div>
                            <div class="rating-stars mb-2">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="fa-solid fa-star @(i <= review.Rating ? "text-warning" : "text-secondary opacity-25")"></i>
                                }
                                <span class="ms-2 small text-muted">(@review.Rating/5)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="mb-2 text-muted">@review.Comment</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(review.AdminReply))
                            {
                                <div class="mt-2 p-3 bg-light rounded-3 border-start border-4 border-primary">
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="fa-solid fa-hospital text-primary me-2"></i>
                                        <strong class="text-dark small">Hastane Yönetimi</strong>
                                        @if (review.AdminReplyDate.HasValue)
                                        {
                                            <span class="text-muted small ms-auto">@review.AdminReplyDate.Value.ToString("dd.MM.yyyy")</span>
                                        }
                                    </div>
                                    <p class="mb-0 small text-muted">@review.AdminReply</p>
                                </div>
                            }
                        </article>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    .full-width-hero {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
    }

    .hover-grow {
        transition: transform 0.3s ease;
    }

    .hover-grow:hover {
        transform: scale(1.05);
    }

    .hover-shadow:hover {
        box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
        transform: translateY(-5px);
    }

    .transition {
        transition: all 0.3s ease;
    }

    .tracking-wider {
        letter-spacing: 2px;
    }

    .eyebrow {
        display: inline-block;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .trendyol-stars {
        display: inline-flex;
        gap: 0.25rem;
        align-items: center;
    }

    .star-btn {
        border: none;
        background: transparent;
        padding: 0;
        line-height: 1;
        font-size: 1.65rem;
        color: #d2d8e0;
        transition: transform 0.12s ease, color 0.12s ease;
    }

    .star-btn:hover {
        transform: translateY(-1px) scale(1.05);
    }

    .star-btn.active {
        color: #ff9800;
    }
</style>

@section Scripts {
    <script>
        (function () {
            const starsWrap = document.getElementById("ratingStars");
            const ratingInput = document.getElementById("RatingInput");
            const ratingText = document.getElementById("ratingText");
            if (!starsWrap || !ratingInput || !ratingText) {
                return;
            }

            const labels = {
                1: "Çok kötü",
                2: "Kötü",
                3: "Orta",
                4: "İyi",
                5: "Çok iyi"
            };

            const starButtons = Array.from(starsWrap.querySelectorAll(".star-btn"));

            function render(value) {
                starButtons.forEach((btn) => {
                    const starValue = Number(btn.getAttribute("data-value"));
                    btn.classList.toggle("active", starValue <= value);
                });

                ratingText.textContent = value > 0
                    ? `${value}/5 - ${labels[value]}`
                    : "Puanınızı seçin";
            }

            starButtons.forEach((btn) => {
                const val = Number(btn.getAttribute("data-value"));

                btn.addEventListener("mouseenter", function () {
                    render(val);
                });

                btn.addEventListener("click", function () {
                    ratingInput.value = String(val);
                    render(val);
                });
            });

            starsWrap.addEventListener("mouseleave", function () {
                const current = Number(ratingInput.value || "0");
                render(current);
            });

            const initial = Number(ratingInput.value || "0");
            render(initial);
        })();
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

