@model HastaneRandevuSistemi.ViewModels.AdminAccountingViewModel
@{
    ViewData["Title"] = "Muhasebe - İşlem Geçmişi";
    var trCulture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
}

<div class="container py-4">
    @await Html.PartialAsync("_AdminAccountingHeader", Model)

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1">Tüm Finansal Hareketler</h5>
                    <p class="text-muted small mb-0">Seçili tarih aralığındaki tüm randevu ve ödeme kayıtları.</p>
                </div>
                <div class="d-flex gap-2">
                     <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">Ödendi: @Model.CompletedAppointments</span>
                     <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">Bekliyor: @Model.PendingAppointments</span>
                </div>
            </div>

            @if (!Model.RecentTransactions.Any())
            {
                <div class="text-muted text-center py-5">Seçili kriterlere uygun işlem kaydı bulunamadı.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle table-hover" id="transactionsTable">
                        <thead class="bg-light">
                            <tr>
                                <th>Tarih / Saat</th>
                                <th>Hasta</th>
                                <th>Doktor / Bölüm</th>
                                <th>Durum</th>
                                <th class="text-end">Tutar</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentTransactions)
                            {
                                var statusClass = item.StatusLabel switch
                                {
                                    "Ödeme Yapıldı" => "text-success",
                                    "İptal / Kayıp" => "text-danger",
                                    "Ödeme Bekliyor" => "text-warning",
                                    _ => "text-secondary"
                                };

                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.AppointmentDate.ToString("dd.MM.yyyy")</div>
                                        <small class="text-muted">@item.AppointmentDate.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@item.PatientName</div>
                                    </td>
                                    <td>
                                        <div>@item.DoctorName</div>
                                        <small class="text-muted">@item.DepartmentName</small>
                                    </td>
                                    <td>
                                        <span class="fw-bold @statusClass">@item.StatusLabel</span>
                                    </td>
                                    <td class="text-end fw-bold">@item.Amount.ToString("C0", trCulture)</td>
                                    <td class="text-end">
                                        @if (!item.IsCollected && item.IsAppointmentFinished && !item.IsHoliday)
                                        {
                                            <form asp-action="MarkCollected" asp-route-id="@item.AppointmentId" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">Tahsil Et</button>
                                            </form>
                                        }
                                        else if (item.IsCollected)
                                        {
                                            <form asp-action="CancelCollected" asp-route-id="@item.AppointmentId" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">İptal</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .bg-light { background-color: #f8f9fa !important; }
</style>
