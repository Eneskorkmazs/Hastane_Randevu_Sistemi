@model HastaneRandevuSistemi.Models.DashboardViewModel

@{
    ViewData["Title"] = "Yönetim Merkezi";
}

<div class="container-fluid px-md-5 py-4 admin-home">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4 border-bottom pb-4">
        <div>
            <h6 class="text-primary fw-bold text-uppercase small mb-1">Sistem Genel Bakış</h6>
            <h1 class="display-6 fw-bold text-dark mb-1">Yönetim Merkezi</h1>
            <p class="text-muted mb-0">Özet bilgileri burada tutup detayları ayrı yönetim sayfalarından takip edin.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="AdminAnalytics" class="btn btn-primary rounded-pill px-4">
                <i class="fa-solid fa-chart-line me-2"></i>Analitik
            </a>
            <a asp-action="AdminAccounting" class="btn btn-success rounded-pill px-4">
                <i class="fa-solid fa-wallet me-2"></i>Muhasebe
            </a>
            <span class="badge bg-white text-dark border px-4 py-2 rounded-pill shadow-sm d-flex align-items-center">
                <i class="fa-solid fa-clock me-2 text-primary"></i>@DateTime.Now.ToString("dd MMMM yyyy")
            </span>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="admin-stat-card bg-white p-4 shadow-sm rounded-4 d-flex align-items-center justify-content-between h-100">
                <div>
                    <p class="text-muted x-small fw-bold mb-1">DOKTORLAR</p>
                    <h2 class="fw-bold mb-0">@Model.TotalDoctors</h2>
                </div>
                <div class="stat-icon bg-primary-soft text-primary"><i class="fa-solid fa-user-md fs-4"></i></div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="admin-stat-card bg-white p-4 shadow-sm rounded-4 d-flex align-items-center justify-content-between h-100">
                <div>
                    <p class="text-muted x-small fw-bold mb-1">BRANŞLAR</p>
                    <h2 class="fw-bold mb-0">@Model.TotalDepartments</h2>
                </div>
                <div class="stat-icon bg-success-soft text-success"><i class="fa-solid fa-hospital fs-4"></i></div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="admin-stat-card bg-white p-4 shadow-sm rounded-4 d-flex align-items-center justify-content-between h-100">
                <div>
                    <p class="text-muted x-small fw-bold mb-1">BUGÜN</p>
                    <h2 class="fw-bold mb-0">@Model.TodaysAppointments</h2>
                    <small class="text-muted">@Model.RemainingTodayAppointments randevu bekliyor</small>
                </div>
                <div class="stat-icon bg-info-soft text-info"><i class="fa-solid fa-calendar-day fs-4"></i></div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="admin-stat-card bg-white p-4 shadow-sm rounded-4 d-flex align-items-center justify-content-between h-100">
                <div>
                    <p class="text-muted x-small fw-bold mb-1">ALINACAK ÖDEME</p>
                    <h2 class="fw-bold mb-0">@Model.PendingRevenue.ToString("C0")</h2>
                    <small class="text-muted">@Model.PendingPaymentAppointments adet işlem</small>
                </div>
                <div class="stat-icon bg-warning-soft text-warning"><i class="fa-solid fa-wallet fs-4"></i></div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Randevu Özeti</h5>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Toplam</span>
                        <strong>@Model.TotalAppointments</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Bekleyen</span>
                        <strong class="text-warning">@Model.PendingAppointments</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Onaylanan</span>
                        <strong class="text-success">@Model.ApprovedAppointments</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Tamamlanan</span>
                        <strong class="text-primary">@Model.CompletedAppointments</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span>İptal</span>
                        <strong class="text-danger">@Model.CancelledAppointments</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">Son Bildirimler & Destek Talepleri</h5>
                            <p class="text-muted small mb-0">Sadece hızlı takip için son sistem hareketleri.</p>
                        </div>
                        <a asp-action="AdminNotifications" class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-3">
                            Tümünü Yönet
                        </a>
                    </div>

                    @if (!Model.LatestNotifications.Any())
                    {
                        <div class="text-muted">Henüz sistem bildirimi bulunmuyor.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in Model.LatestNotifications.Take(5))
                            {
                                var isUnread = !item.IsRead;
                                var badgeBg = item.Type == "Destek" ? "bg-danger" : item.Type == "Duyuru" ? "bg-info" : item.Type == "Uyarı" ? "bg-warning" : "bg-primary";

                                <div id="dash-notification-@item.Id" class="list-group-item px-0 py-3 d-flex justify-content-between align-items-start gap-3 @(isUnread ? "bg-primary-soft px-3 rounded-3 mb-1" : "")">
                                    <div>
                                        <div class="d-flex gap-2 align-items-center mb-1">
                                            <span class="badge @badgeBg text-white border">@item.Type</span>
                                            <strong class="text-dark">@item.Title</strong>
                                            @if (isUnread)
                                            {
                                                <span class="badge bg-danger rounded-circle p-1" title="Okunmadı"><span class="visually-hidden">Okunmadı</span></span>
                                            }
                                        </div>
                                        <p class="mb-1 text-muted small" style="white-space: pre-line;">@item.Message</p>
                                        <small class="text-secondary"><i class="fa-solid fa-calendar-days me-1"></i> @item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</small>
                                    </div>
                                    <div class="d-flex gap-2 flex-shrink-0 align-items-center">
                                        @if (isUnread)
                                        {
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold dash-mark-read-btn" data-id="@item.Id">
                                                <i class="fa-solid fa-check me-1"></i> Okundu
                                            </button>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Link))
                                        {
                                            <a href="@item.Link" class="btn btn-sm btn-light rounded-pill px-3 fw-bold"><i class="fa-solid fa-link me-1"></i> Git</a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <h2 class="h4 fw-bold mb-1">Yönetim Sayfaları</h2>
        <p class="text-muted mb-0">Grafikler, finans, raporlar ve geri bildirimler ayrı sayfalarda düzenlendi.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-chart-line text-primary me-2"></i>Hizmet ve Performans Analizi</h5>
            <div class="row g-3">
                <div class="col-12 col-md-6 col-xl-4">
                    <a asp-action="AdminServiceAnalysis" class="admin-module-card text-decoration-none">
                        <span class="module-icon bg-primary-soft text-primary"><i class="fa-solid fa-microscope"></i></span>
                        <span>
                            <strong>Hizmet Analizi</strong>
                            <small>İşlem hacmi, saatlik yoğunluk ve hizmet verimliliği</small>
                        </span>
                    </a>
                </div>
                <div class="col-12 col-md-6 col-xl-4">
                    <a asp-action="AdminDoctorInsights" class="admin-module-card text-decoration-none">
                        <span class="module-icon bg-info-soft text-info"><i class="fa-solid fa-user-doctor"></i></span>
                        <span>
                            <strong>Doktor Performansı</strong>
                            <small>Doktor bazlı randevu, durum ve yoğunluk analizi</small>
                        </span>
                    </a>
                </div>
                <div class="col-12 col-md-6 col-xl-4">
                    <a asp-action="AdminAnalytics" class="admin-module-card text-decoration-none">
                        <span class="module-icon bg-info-soft text-info"><i class="fa-solid fa-chart-pie"></i></span>
                        <span>
                            <strong>Genel Grafikler</strong>
                            <small>Randevu dağılımı, haftalık trend ve poliklinik yoğunluğu</small>
                        </span>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 mt-4">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-calculator text-success me-2"></i>Muhasebe ve Finansal Yönetim</h5>
            <div class="row g-3">
                <div class="col-12 col-md-6 col-xl-4">
                    <a asp-action="AdminAccounting" class="admin-module-card text-decoration-none">
                        <span class="module-icon bg-success-soft text-success"><i class="fa-solid fa-wallet"></i></span>
                        <span>
                            <strong>Finansal Özet</strong>
                            <small>Tahsilat, bekleyen ödemeler ve finans detayları</small>
                        </span>
                    </a>
                </div>
                <div class="col-12 col-md-6 col-xl-4">
                    <a asp-action="AdminAccountingDepartments" class="admin-module-card text-decoration-none">
                        <span class="module-icon bg-success-soft text-success"><i class="fa-solid fa-building"></i></span>
                        <span>
                            <strong>Bölüm Analizleri</strong>
                            <small>Bölüm bazlı gelir, hasta payı ve finansal performans</small>
                        </span>
                    </a>
                </div>
                <div class="col-12 col-md-6 col-xl-4">
                    <a asp-action="Tahsilat" class="admin-module-card text-decoration-none">
                        <span class="module-icon bg-success-soft text-success"><i class="fa-solid fa-hand-holding-dollar"></i></span>
                        <span>
                            <strong>Tahsilat Onayı</strong>
                            <small>Bekleyen randevu ödemelerini onaylama ekranı</small>
                        </span>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 mt-4">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-gears text-secondary me-2"></i>Sistem ve İletişim</h5>
            <div class="row g-3">
                <div class="col-12 col-md-6 col-xl-4">
                    <a asp-action="AdminHospitalReviews" class="admin-module-card text-decoration-none">
                        <span class="module-icon bg-warning-soft text-warning"><i class="fa-solid fa-star"></i></span>
                        <span>
                            <strong>Hasta Yorumları</strong>
                            <small>Puanlar, yorumlar ve geri bildirim yönetimi</small>
                        </span>
                    </a>
                </div>
                <div class="col-12 col-md-6 col-xl-4">
                    <a asp-action="CreateAnnouncement" class="admin-module-card text-decoration-none">
                        <span class="module-icon bg-primary-soft text-primary"><i class="fa-solid fa-bullhorn"></i></span>
                        <span>
                            <strong>Duyuru Gönder</strong>
                            <small>Hasta, doktor ve sekreter gruplarına bilgilendirme</small>
                        </span>
                    </a>
                </div>
                <div class="col-12 col-md-6 col-xl-4">
                    <a asp-action="AdminReport" class="admin-module-card text-decoration-none">
                        <span class="module-icon bg-info-soft text-info"><i class="fa-solid fa-file-lines"></i></span>
                        <span>
                            <strong>Sistem Raporları</strong>
                            <small>Tarih, branş ve durum bazlı operasyon listeleri</small>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white p-4 rounded-4 shadow-sm border d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div>
            <h5 class="fw-bold mb-1">Hızlı İşlemler</h5>
            <p class="text-muted mb-0 small">Yeni kayıt ve temel yönetim işlemleri.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Doctor" asp-action="Create" class="btn btn-outline-dark rounded-pill fw-bold px-4">Doktor Ekle</a>
            <a asp-controller="Department" asp-action="Create" class="btn btn-outline-dark rounded-pill fw-bold px-4">Bölüm Ekle</a>
            <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary rounded-pill fw-bold px-4 shadow-sm">Yeni Randevu</a>
        </div>
    </div>
</div>

<style>
    .admin-home .admin-module-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-height: 118px;
        padding: 1.25rem;
        border: 1px solid #e8eef6;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 0.35rem 1rem rgba(13, 40, 69, 0.06);
        color: #1f2937;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

    .admin-home .admin-module-card:hover {
        transform: translateY(-2px);
        border-color: #c9d9f0;
        box-shadow: 0 0.7rem 1.4rem rgba(13, 40, 69, 0.1);
    }

    .admin-home .module-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        font-size: 1.25rem;
    }

    .admin-home .admin-module-card strong {
        display: block;
        font-size: 1rem;
        margin-bottom: 0.25rem;
    }

    .admin-home .admin-module-card small {
        display: block;
        color: #667085;
        line-height: 1.35;
    }
</style>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            document.querySelectorAll('.dash-mark-read-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    const row = document.getElementById('dash-notification-' + id);

                    fetch('@Url.Action("MarkAdminNotificationRead", "Home")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: new URLSearchParams({ id: id })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            if (row) { row.classList.remove('bg-primary-soft', 'px-3', 'rounded-3', 'mb-1'); }
                            this.remove();
                            const badge = document.getElementById('adminNotificationBadge');
                            if (badge) {
                                let count = parseInt(badge.textContent || '0') - 1;
                                if (count <= 0) { badge.style.display = 'none'; }
                                else { badge.textContent = count; }
                            }
                        }
                    });
                });
            });
        });
    </script>
}
