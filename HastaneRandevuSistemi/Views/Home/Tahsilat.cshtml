@model HastaneRandevuSistemi.ViewModels.TahsilatDashboardViewModel

@{
    ViewData["Title"] = "Tahsilat Merkezi";
    var trCulture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="tahsilat-hero mb-4">
        <div>
            <span class="eyebrow">Finans Operasyonu</span>
            <h1 class="mb-2">Tahsilat Merkezi</h1>
            <p class="mb-0">Bugün alınacak ödemeleri, gecikmiş tahsilatları ve son kasa hareketlerini tek ekrandan yönetin.</p>
        </div>
        <div class="hero-actions">
            <form asp-action="MarkAllCollected" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Url.Action("Tahsilat", "Home")" />
                <button type="submit" class="btn btn-warning fw-bold rounded-pill px-4">Bütün Ödemeleri Al</button>
            </form>
            <a asp-action="AdminAccounting" class="btn btn-light text-primary fw-bold rounded-pill px-4">Muhasebe</a>
            <a asp-action="AdminDashboard" class="btn btn-outline-light rounded-pill px-4">Panele Dön</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="metric-card">
                <span>Bekleyen Toplam</span>
                <strong>@Model.PendingTotal.ToString("C0", trCulture)</strong>
                <small>@Model.PendingCount kayıt</small>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card warning">
                <span>Gecikmiş Tahsilat</span>
                <strong>@Model.OverdueTotal.ToString("C0", trCulture)</strong>
                <small>@Model.OverdueCount kayıt</small>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card info">
                <span>Bugün Alınabilir</span>
                <strong>@Model.TodayTotal.ToString("C0", trCulture)</strong>
                <small>@Model.TodayCount kayıt</small>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card success">
                <span>Bugün Kasa</span>
                <strong>@Model.CollectedTodayTotal.ToString("C0", trCulture)</strong>
                <small>Tahsil edilen toplam</small>
            </div>
        </div>
    </div>

    <!-- Toplam Kasa Kartı -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-3 d-flex flex-row align-items-center gap-4"
                 style="background: linear-gradient(135deg, #004e92 0%, #000428 100%); color:#fff;">
                <div class="rounded-3 d-flex align-items-center justify-content-center bg-white bg-opacity-10"
                     style="width:60px;height:60px;flex-shrink:0;">
                    <i class="fa-solid fa-vault fa-xl text-white"></i>
                </div>
                <div>
                    <div class="small text-white-50 fw-semibold text-uppercase" style="letter-spacing:.08em;">Toplam Kasa (Tüm Zamanlar)</div>
                    <div class="fw-black" style="font-size:2.2rem;line-height:1.1;">
                        @((ViewBag.AllCollectedTotal as decimal? ?? 0m).ToString("C0", trCulture))
                    </div>
                    <div class="small text-white-50">Sisteme kayıtlı tüm tahsil edilen ödemeler</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold mb-1">Öncelikli Tahsilatlar</h5>
                            <p class="text-muted small mb-0">Gecikmiş kayıtlar önce gelir, sonra bugün alınabilecek ödemeler listelenir.</p>
                        </div>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2">@Model.PendingItems.Count kayıt</span>
                    </div>

                    @if (!Model.PendingItems.Any())
                    {
                        <div class="empty-state">
                            <i class="fa-solid fa-circle-check"></i>
                            <p class="mb-0">Tahsilat bekleyen kayıt kalmadı.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Öncelik</th>
                                        <th>Hasta</th>
                                        <th>Doktor / Bölüm</th>
                                        <th>Tarih</th>
                                        <th class="text-end">Tutar</th>
                                        <th class="text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model.PendingItems.OrderBy(x => x.AppointmentDate))
                                    {
                                        var isOverdue = payment.AppointmentDate.Date < DateTime.Today;
                                        <tr>
                                            <td>
                                                <span class="badge rounded-pill @(isOverdue ? "bg-danger" : "bg-warning text-dark")">
                                                    @(isOverdue ? "Gecikmiş" : "Bugün")
                                                </span>
                                            </td>
                                            <td class="fw-semibold">@payment.PatientName</td>
                                            <td>
                                                <div>@payment.DoctorName</div>
                                                <div class="small text-muted">@payment.DepartmentName</div>
                                            </td>
                                            <td>@payment.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td class="text-end fw-semibold">@payment.Amount.ToString("C0", trCulture)</td>
                                            <td class="text-end">
                                                <form asp-action="MarkCollected" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@payment.AppointmentId" />
                                                    <input type="hidden" name="returnUrl" value="@Url.Action("Tahsilat", "Home")" />
                                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                                        <i class="fa-solid fa-check me-1"></i>Tahsil Et
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Hızlı Özet</h5>
                    <div class="summary-stack">
                        <div class="summary-tile">
                            <span>En yüksek bekleyen bölüm</span>
                            <strong>@Model.TopDepartmentName</strong>
                            <small>@Model.TopDepartmentAmount.ToString("C0", trCulture)</small>
                        </div>
                        <div class="summary-tile">
                            <span>En yüksek bekleyen doktor</span>
                            <strong>@Model.TopDoctorName</strong>
                            <small>@Model.TopDoctorAmount.ToString("C0", trCulture)</small>
                        </div>
                        <div class="summary-tile subtle">
                            <span>Operasyon notu</span>
                            <strong>Önce gecikmiş tahsilatları kapat</strong>
                            <small>Kasa akışında en hızlı iyileşme bu listeden gelir.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1">Son Tahsil Edilenler</h5>
                    <p class="text-muted small mb-0">Kasaya yeni giren hareketleri hızlıca kontrol edin.</p>
                </div>
                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">@Model.RecentCollectedItems.Count hareket</span>
            </div>

            @if (!Model.RecentCollectedItems.Any())
            {
                <div class="empty-state compact">
                    <i class="fa-solid fa-receipt"></i>
                    <p class="mb-0">Henüz tahsil edilmiş kayıt bulunmuyor.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Hasta</th>
                                <th>Doktor</th>
                                <th>Bölüm</th>
                                <th>Tarih</th>
                                <th class="text-end">Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentCollectedItems)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.PatientName</td>
                                    <td>@item.DoctorName</td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="text-end fw-semibold text-success">@item.Amount.ToString("C0", trCulture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .tahsilat-hero {
        border-radius: 30px;
        padding: 2rem;
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        color: #fff;
        background: linear-gradient(135deg, #0f5a45 0%, #05281f 100%);
        box-shadow: 0 24px 60px rgba(5, 40, 31, 0.18);
    }

    .tahsilat-hero h1 {
        font-size: clamp(2rem, 3vw, 3rem);
        font-weight: 700;
        line-height: 1.1;
    }

    .eyebrow {
        display: inline-block;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-weight: 700;
        margin-bottom: 0.75rem;
        color: rgba(255, 255, 255, 0.7);
    }

    .hero-actions {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .metric-card {
        height: 100%;
        border-radius: 22px;
        padding: 1.25rem;
        background: linear-gradient(180deg, #ffffff 0%, #f4fbf7 100%);
        box-shadow: 0 15px 35px rgba(22, 36, 56, 0.08);
    }

    .metric-card.warning { background: linear-gradient(180deg, #fffaf1 0%, #ffe5bf 100%); }
    .metric-card.info { background: linear-gradient(180deg, #f4fcff 0%, #d6f0ff 100%); }
    .metric-card.success { background: linear-gradient(180deg, #f4fff8 0%, #cff3dd 100%); }

    .metric-card span, .metric-card small {
        display: block;
        color: #5f6f7d;
    }

    .metric-card strong {
        display: block;
        font-size: 2rem;
        line-height: 1;
        margin: 0.6rem 0;
        color: #102a43;
    }

    .summary-stack {
        display: grid;
        gap: 1rem;
    }

    .summary-tile {
        border-radius: 18px;
        padding: 1rem 1.1rem;
        background: linear-gradient(180deg, #f8fbfd 0%, #edf3f7 100%);
        border: 1px solid #e2eaf1;
    }

    .summary-tile.subtle {
        background: linear-gradient(180deg, #f6fbf8 0%, #e7f4ec 100%);
    }

    .summary-tile span, .summary-tile small {
        display: block;
        color: #607283;
    }

    .summary-tile strong {
        display: block;
        color: #102a43;
        font-size: 1.08rem;
        margin: 0.35rem 0;
    }

    .empty-state {
        min-height: 220px;
        display: grid;
        place-items: center;
        text-align: center;
        color: #7d8a97;
        gap: 0.75rem;
    }

    .empty-state.compact {
        min-height: 140px;
    }

    .empty-state i {
        font-size: 2.3rem;
    }

    @@media (max-width: 991px) {
        .tahsilat-hero {
            flex-direction: column;
        }
    }
</style>
