@model HastaneRandevuSistemi.ViewModels.PrescriptionDraftViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reçete Önizleme</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background: #f4f6f8; color: #111; }
        .sheet { max-width: 900px; margin: 24px auto; background: #fff; padding: 32px; border-radius: 16px; box-shadow: 0 12px 30px rgba(0,0,0,.08); }
        .head { display:flex; justify-content:space-between; gap: 20px; border-bottom: 1px solid #e6e8eb; padding-bottom: 16px; margin-bottom: 24px; }
        .title { font-size: 28px; font-weight: 700; }
        .muted { color: #667; }
        .box { background:#f8fafc; border:1px solid #e5e7eb; padding:16px; border-radius:12px; margin-bottom: 16px; }
        .label { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: #667; margin-bottom: 6px; }
        .value { font-size: 16px; font-weight: 600; }
        .actions { display:flex; gap: 12px; justify-content:flex-end; margin-top: 20px; }
        @@media print { .actions { display:none; } body { background:#fff; } .sheet { box-shadow:none; margin:0; border-radius:0; } }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="head">
            <div>
                <div class="title">Dijital Reçete</div>
                <div class="muted">@Model.PrescriptionDate.ToString("dd.MM.yyyy HH:mm")</div>
            </div>
            <div class="muted text-end">
                <div><strong>Doktor:</strong> @Model.DoctorName</div>
                <div><strong>Poliklinik:</strong> @Model.DepartmentName</div>
            </div>
        </div>

        <div class="box">
            <div class="label">Hasta</div>
            <div class="value">@Model.PatientName @Model.PatientSurname</div>
        </div>

        <div class="box">
            <div class="label">Tanı</div>
            <div class="value">@Model.Diagnosis</div>
        </div>

        <div class="box">
            <div class="label">İlaçlar</div>
            <div class="value">@Model.Medications</div>
        </div>

        <div class="box">
            <div class="label">Notlar</div>
            <div class="value">@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</div>
        </div>

        <div class="actions">
            <a asp-action="DownloadPrescriptionPdf" asp-route-appointmentId="@Model.AppointmentId">PDF İndir</a>
            <button onclick="window.print()" type="button">Yazdır</button>
        </div>
    </div>
</body>
</html>

