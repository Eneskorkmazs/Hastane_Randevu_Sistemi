@using HastaneRandevuSistemi.Models
@{
    ViewData["Title"] = "Sekreter Paneli";
    var pendingAppointments = (List<Appointment>)ViewBag.PendingAppointments;
    var unsentPrescriptions = (List<Appointment>)ViewBag.UnsentPrescriptions;
    var appointmentsForPrescription = (List<Appointment>)ViewBag.AppointmentsForPrescription;
    var sentPrescriptions = ViewBag.SentPrescriptions as List<Appointment> ?? new List<Appointment>();
    
    // Reminders & Stats
    var upcomingNext2Hours = ViewBag.UpcomingNext2Hours as List<Appointment> ?? new List<Appointment>();
    int todaysTotal = ViewBag.TodaysTotal ?? 0;
    int todaysCompleted = ViewBag.TodaysCompleted ?? 0;
    int urgentApprovals = ViewBag.UrgentApprovals ?? 0;
    int delayedPrescriptions = ViewBag.DelayedPrescriptions ?? 0;
    
    double todayProgress = todaysTotal > 0 ? (double)todaysCompleted / todaysTotal * 100 : 0;
}

<div class="container-fluid px-md-4 py-4">
    <div class="row g-4">
        <!-- Main Content (Left) -->
        <div class="col-lg-9">
            <div class="d-flex align-items-center mb-4">
                <div>
                    <h2 class="mb-1 fw-bold text-dark"><i class="fa-solid fa-clipboard-check text-primary me-3"></i>Sekreter Operasyon Merkezi</h2>
                    <p class="text-muted mb-0">Hastanenin günlük operasyonlarını, onaylarını ve reçete akışını buradan yönetin.</p>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 text-center">
                            <div class="small text-muted text-uppercase fw-bold mb-2">Onay Bekleyen</div>
                            <div class="h2 fw-bold mb-0 @(pendingAppointments.Count > 5 ? "text-danger" : "text-dark")">@pendingAppointments.Count</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 text-center">
                            <div class="small text-muted text-uppercase fw-bold mb-2">Bekleyen Reçete</div>
                            <div class="h2 fw-bold mb-0 text-warning">@unsentPrescriptions.Count</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 text-center">
                            <div class="small text-muted text-uppercase fw-bold mb-2">Bugünkü İlerleme</div>
                            <div class="h2 fw-bold mb-0 text-success">% @todayProgress.ToString("F0")</div>
                            <div class="progress mt-2" style="height: 4px;">
                                <div class="progress-bar bg-success" style="width: @todayProgress%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white p-4 border-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0"><i class="fa-solid fa-calendar-check text-primary me-2"></i>Onay Bekleyen Randevular</h5>
                        <span class="badge bg-light text-dark border rounded-pill px-3">Toplam @pendingAppointments.Count</span>
                    </div>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (!pendingAppointments.Any())
                    {
                        <div class="text-center py-5">
                            <div class="display-1 text-light mb-3"><i class="fa-solid fa-check-circle"></i></div>
                            <p class="text-muted">Onay bekleyen herhangi bir randevu bulunmamaktadır.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead class="text-muted small text-uppercase">
                                    <tr>
                                        <th>Tarih</th>
                                        <th>Hasta</th>
                                        <th>Doktor</th>
                                        <th>Bölüm</th>
                                        <th class="text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in pendingAppointments)
                                    {
                                        <tr class="@(item.AppointmentDate.Date == DateTime.Today ? "table-light border-start border-4 border-warning" : "")">
                                            <td>
                                                <div class="fw-bold">@item.AppointmentDate.ToString("HH:mm")</div>
                                                <div class="small text-muted">@item.AppointmentDate.ToString("dd.MM.yyyy")</div>
                                            </td>
                                            <td>
                                                <div class="fw-bold">@item.PatientName @item.PatientSurname</div>
                                                <div class="small text-muted">@item.PatientPhone</div>
                                            </td>
                                            <td>@(item.Doctor != null ? $"{item.Doctor.Title} {item.Doctor.Name} {item.Doctor.Surname}" : "-")</td>
                                            <td><span class="badge bg-info-soft text-info rounded-pill">@item.Doctor?.Department?.Name</span></td>
                                            <td class="text-end">
                                                <div class="d-flex justify-content-end gap-2">
                                                    <form asp-action="ApproveAppointment" asp-route-id="@item.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">Onayla</button>
                                                    </form>
                                                    <form asp-action="RejectAppointment" asp-route-id="@item.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">Reddet</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white p-4 border-0">
                    <h5 class="fw-bold mb-0"><i class="fa-solid fa-file-prescription text-primary me-2"></i>Gönderilmeyi Bekleyen Reçeteler</h5>
                    <p class="small text-muted mb-0">Doktorlar tarafından yazılmış, hastaya iletilmeyi bekleyen dijital reçeteler.</p>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (!unsentPrescriptions.Any())
                    {
                        <div class="text-center py-4">
                            <i class="fa-solid fa-envelope-open text-light display-4 mb-3"></i>
                            <p class="text-muted mb-0">Gönderilmeyi bekleyen yeni reçete bulunmuyor.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead class="text-muted small text-uppercase">
                                    <tr>
                                        <th>Hasta</th>
                                        <th>Doktor / Bölüm</th>
                                        <th>Yazıldı</th>
                                        <th class="text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in unsentPrescriptions)
                                    {
                                        <tr>
                                            <td class="fw-bold">@item.PatientName @item.PatientSurname</td>
                                            <td>
                                                <div class="small">@(item.Doctor != null ? $"{item.Doctor.Title} {item.Doctor.Name} {item.Doctor.Surname}" : "-")</div>
                                                <div class="x-small text-muted">@item.Doctor?.Department?.Name</div>
                                            </td>
                                            <td class="small text-muted">@(item.PrescriptionCreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                            <td class="text-end">
                                                <form asp-action="SendPrescription" asp-route-id="@item.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4">
                                                        <i class="fa-solid fa-paper-plane me-2"></i>Hastaya Gönder
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white p-4 border-0 d-flex align-items-center gap-2">
                    <h5 class="fw-bold mb-0"><i class="fa-solid fa-circle-check text-success me-2"></i>Gönderilmiş Reçeteler</h5>
                    <span class="badge bg-success rounded-pill px-3">@sentPrescriptions.Count</span>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (!sentPrescriptions.Any())
                    {
                        <p class="text-muted mb-0 small">Henüz gönderilmiş reçete yok.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead class="text-muted small text-uppercase">
                                    <tr>
                                        <th>Hasta</th>
                                        <th>Doktor</th>
                                        <th>Yazıldı</th>
                                        <th>Gönderildi</th>
                                        <th>Gönderen</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in sentPrescriptions)
                                    {
                                        <tr>
                                            <td class="fw-bold">@item.PatientName @item.PatientSurname</td>
                                            <td class="small">Dr. @item.Doctor?.Surname</td>
                                            <td class="small text-muted">@(item.PrescriptionCreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                            <td>
                                                <span class="badge bg-success rounded-pill px-3">
                                                    <i class="fa-solid fa-check me-1"></i>@(item.PrescriptionSentAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                                                </span>
                                            </td>
                                            <td class="small text-muted">@(item.PrescriptionSentByName ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Reminders Sidebar (Right) -->
        <div class="col-lg-3">
            <div class="sticky-top" style="top: 100px;">
                <h5 class="fw-bold mb-3 d-flex align-items-center">
                    <i class="fa-solid fa-bell text-warning me-2"></i> Operasyonel Hatırlatıcılar
                </h5>

                <!-- Urgent Alerts -->
                @if (urgentApprovals > 0 || delayedPrescriptions > 0)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-danger-soft border-start border-4 border-danger">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-danger mb-3 small text-uppercase">Dikkat Gerekenler</h6>
                            
                            @if (urgentApprovals > 0)
                            {
                                <div class="d-flex gap-3 mb-3">
                                    <div class="text-danger h4 mb-0"><i class="fa-solid fa-clock-rotate-left"></i></div>
                                    <div>
                                        <div class="fw-bold small text-dark">Bugüne Ait @urgentApprovals Bekleyen Onay</div>
                                        <div class="x-small text-muted">Hemen onaylamanız veya reddetmeniz önerilir.</div>
                                    </div>
                                </div>
                            }

                            @if (delayedPrescriptions > 0)
                            {
                                <div class="d-flex gap-3">
                                    <div class="text-danger h4 mb-0"><i class="fa-solid fa-triangle-exclamation"></i></div>
                                    <div>
                                        <div class="fw-bold small text-dark">@delayedPrescriptions Gecikmiş Reçete</div>
                                        <div class="x-small text-muted">Önceki günlerden kalan reçete kayıtları var.</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Next 2 Hours -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 px-4 border-0 border-bottom">
                        <h6 class="fw-bold mb-0 small text-uppercase"><i class="fa-solid fa-hourglass-start text-primary me-2"></i>Sıradaki Randevular (2 Saat)</h6>
                    </div>
                    <div class="card-body p-0">
                        @if (!upcomingNext2Hours.Any())
                        {
                            <div class="p-4 text-center text-muted small">
                                Önümüzdeki 2 saat içinde onaylanmış randevu bulunmuyor.
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var next in upcomingNext2Hours)
                                {
                                    <div class="list-group-item p-3 border-0 border-bottom">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="badge bg-primary rounded-pill">@next.AppointmentDate.ToString("HH:mm")</span>
                                            <span class="small text-muted">@next.Doctor?.Department?.Name</span>
                                        </div>
                                        <div class="fw-bold text-dark small">@next.PatientName @next.PatientSurname</div>
                                        <div class="x-small text-muted">Dr. @next.Doctor?.Surname</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-light border-0 text-center py-2">
                        <a href="#" class="x-small text-primary text-decoration-none fw-bold">TÜM GÜNLÜK LİSTE</a>
                    </div>
                </div>

                <!-- Daily Summary Box -->
                <div class="card border-0 shadow-sm rounded-4 bg-primary text-white">
                    <div class="card-body p-4">
                        <h6 class="small text-uppercase fw-bold mb-3 opacity-75">Günün Özeti</h6>
                        <div class="row text-center">
                            <div class="col-6 border-end border-white border-opacity-25">
                                <div class="h3 fw-bold mb-0">@todaysTotal</div>
                                <div class="x-small opacity-75">Toplam</div>
                            </div>
                            <div class="col-6">
                                <div class="h3 fw-bold mb-0">@todaysCompleted</div>
                                <div class="x-small opacity-75">Tamamlanan</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-info-soft { background-color: rgba(13, 202, 240, 0.1); }
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.05); }
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.05); }
    .x-small { font-size: 0.75rem; }
    .nav-pills .nav-link { color: #6c757d; background: #f8f9fa; }
    .nav-pills .nav-link.active { background-color: #0d6efd; color: #fff; }
</style>
